---
import "../styles/global.css";
import RailDesktop from "../components/rail/RailDesktop.astro";
import RailDock from "../components/rail/RailDock.astro";
import RailPageShell from "../components/shell/RailPageShell.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import { ClientRouter } from "astro:transitions";
import type { SeoMeta } from "../lib/seo";

type WritingItem = {
  id: string;
  title: string;
  publishedAt: Date;
  order: number;
};

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  resourceHints?: string[];
  seoType?: "website" | "article";
  articleSection?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  writingItems: WritingItem[];
  writingType: "blogs" | "notes";
  activeId: string;
  backHref?: string;
  backLabel?: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  resourceHints = [],
  seoType = "article",
  articleSection,
  articlePublishedTime,
  articleModifiedTime,
  writingItems,
  activeId,
  writingType = "blogs",
  backHref = "/writing",
  backLabel = "Back to writing",
} = Astro.props as Props;

const writingRailItems = writingItems.map((item) => ({
  id: item.id,
  href: `/writing/${writingType}/${item.id}`,
  primary: item.title,
  secondary: `published ${item.publishedAt.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
  })}`,
}));

const sectionLabel = writingType === "blogs" ? "Blogs" : "Notes";
const articleSectionLabel = articleSection ?? sectionLabel;
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
      resourceHints={resourceHints}
      articleSection={articleSectionLabel}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
    />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <RailPageShell
      backHref={backHref}
      backLabel={backLabel}
      sectionLabel={sectionLabel}
  >
      <RailDock
        slot="dock"
        items={writingRailItems}
        activeId={activeId}
        ariaLabel="Writing pages"
        mobileDensity="compact"
      />

      <RailDesktop
        slot="rail"
        items={writingRailItems}
        activeId={activeId}
        ariaLabel="Writing pages"
      />

      <slot />
    </RailPageShell>
  </body>
</html>
