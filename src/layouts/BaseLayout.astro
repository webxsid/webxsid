---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Container from "../components/shell/Container.astro";
import Nav from "../components/shell/Nav.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import { ClientRouter, fade } from "astro:transitions";
import { ShellHeader } from "../components/react/header/ShellHeader";
import SiteIcon from "../../assets/SiteIcon.png";

type SeoMeta = {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
};

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  backHref?: string;
  backLabel?: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  backHref,
  backLabel = "Back",
} = Astro.props as Props;

const brandIcon = await getImage({
  src: SiteIcon,
  width: 64,
  height: 64,
  format: "webp",
});
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <SeoHead title={title} description={description} pathname={Astro.url.pathname} seo={seo} />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <header class="sticky top-0 z-50 pt-3" transition:animate="none">
      <Container>
        <ShellHeader
          client:load
          transition:persist
          backHref={backHref}
          backLabel={backLabel}
          brandIcon={brandIcon}
          currentPath={Astro.url.pathname}
        />
      </Container>
    </header>

    <Container
      class="lg:grid lg:grid-cols-[auto_minmax(0,1fr)] lg:items-start lg:gap-8"
    >
      <aside class="relative lg:z-20 lg:sticky lg:top-24 lg:pt-4">
        <Nav />
      </aside>

      <main
        class="relative z-10 pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
        transition:animate={fade({ duration: "0.24s" })}
      >
        <slot />
      </main>
    </Container>

    <SiteFooter transition:persist transition:name="site-footer" />
  </body>
</html>
