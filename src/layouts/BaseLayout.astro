---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Container from "../components/shell/Container.astro";
import Nav from "../components/shell/Nav.astro";
import ShellLoadBoot from "../components/shell/ShellLoadBoot.astro";
import ShellLoadUX from "../components/shell/ShellLoadUX.astro";
import ThemePicker from "../components/shell/ThemePicker.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import { ClientRouter, fade } from "astro:transitions";
import { ShellHeader } from "../components/react/header/ShellHeader";
import type { SeoMeta } from "../lib/seo";
import SiteIcon from "../../assets/SiteIcon.png";

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  resourceHints?: string[];
  seoType?: "website" | "article";
  keywords?: string[];
  articleTags?: string[];
  articleSection?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  backHref?: string;
  backLabel?: string;
  fullBleed?: boolean;
  hideRail?: boolean;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  resourceHints = [],
  seoType = "website",
  keywords = [],
  articleTags = [],
  articleSection,
  articlePublishedTime,
  articleModifiedTime,
  backHref,
  backLabel = "Back",
  fullBleed = false,
  hideRail = false,
} = Astro.props as Props;

const [references, notes, nowEntries] = await Promise.all([
  getCollection("references"),
  getCollection("notes"),
  getCollection("now"),
]);

const brandIcon = await getImage({
  src: SiteIcon,
  width: 64,
  height: 64,
  format: "webp",
});
---

<html
  lang="en"
  data-theme="graphite"
  data-theme-family="graphite"
  data-theme-mode="system"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <ShellLoadBoot />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
      keywords={keywords}
      articleTags={articleTags}
      resourceHints={resourceHints}
      articleSection={articleSection}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
    />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <ShellLoadUX />
    <header
      data-shell-header
      class="shell-header-bar sticky top-0 z-50 pt-3"
      transition:animate="none"
    >
      <div
        class:list={[
          "w-full",
          fullBleed
            ? "px-3 sm:px-5 lg:px-6"
            : "mx-auto max-w-5xl px-3 sm:px-5 lg:px-6",
        ]}
      >
        <ShellHeader
          client:load
          transition:persist
          backHref={backHref}
          backLabel={backLabel}
          brandIcon={brandIcon}
          currentPath={Astro.url.pathname}
          desktopRail={!hideRail && !fullBleed}
          hasReferences={references.length > 0}
          hasNotes={notes.length > 0}
          hasNow={nowEntries.length > 0}
        >
          <ThemePicker
            align="start"
            triggerClass="shell-brand-button motion-surface"
          />
        </ShellHeader>
      </div>
    </header>

    {
      fullBleed ? (
        <main
          data-shell-main
          class="motion-page relative z-10 pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
          transition:animate={fade({ duration: "0.24s" })}
        >
          <slot />
        </main>
      ) : hideRail ? (
        <Container>
          <main
            data-shell-main
            class="motion-page relative z-10 min-h-[calc(100svh-7rem)] pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
            transition:animate={fade({ duration: "0.24s" })}
          >
            <slot />
          </main>
        </Container>
      ) : (
        <Container class="lg:grid lg:grid-cols-[auto_minmax(0,1fr)] lg:items-start lg:gap-8">
          <aside class="relative lg:z-20 lg:sticky lg:top-24 lg:pt-4">
            <Nav />
          </aside>

          <main
            data-shell-main
            class="motion-page relative z-10 pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
            transition:animate={fade({ duration: "0.24s" })}
          >
            <slot />
          </main>
        </Container>
      )
    }

    <SiteFooter transition:persist transition:name="site-footer" />

    <script>
      // Slide the header away while reading down, bring it back on any scroll
      // up. It stays put near the top, while a menu is open, and under
      // reduced motion; CSS keeps it visible while it holds focus.
      const headerQuery = "[data-shell-header]";
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let previousScrollY = window.scrollY;
      let direction = 0;
      let directionDistance = 0;

      const setHidden = (hidden: boolean) => {
        const header = document.querySelector<HTMLElement>(headerQuery);
        if (!header) return;
        if (hidden && (reducedMotion.matches || hasOpenMenu(header))) return;
        if ((header.dataset.hidden === "true") === hidden) return;

        header.dataset.hidden = String(hidden);
        document.documentElement.dataset.shellHeaderHidden = String(hidden);
      };

      const hasOpenMenu = (header: HTMLElement) =>
        Boolean(
          header.querySelector('[aria-expanded="true"], details[open]') ||
            document.querySelector("[data-shell-popup]"),
        );

      const resetHeader = () => {
        previousScrollY = window.scrollY;
        direction = 0;
        directionDistance = 0;
        document.querySelector<HTMLElement>(headerQuery)?.removeAttribute("data-hidden");
        delete document.documentElement.dataset.shellHeaderHidden;
      };

      window.addEventListener(
        "scroll",
        () => {
          const scrollY = Math.max(0, window.scrollY);
          const delta = scrollY - previousScrollY;
          previousScrollY = scrollY;

          if (scrollY <= 24) {
            direction = 0;
            directionDistance = 0;
            setHidden(false);
            return;
          }

          if (Math.abs(delta) < 2) return;

          const nextDirection = Math.sign(delta);
          if (nextDirection !== direction) {
            direction = nextDirection;
            directionDistance = 0;
          }

          directionDistance += Math.abs(delta);
          if (direction < 0 && directionDistance >= 16) {
            setHidden(false);
          } else if (direction > 0 && scrollY >= 120 && directionDistance >= 24) {
            setHidden(true);
          }
        },
        { passive: true },
      );

      document.addEventListener("astro:after-swap", resetHeader);
    </script>
  </body>
</html>
