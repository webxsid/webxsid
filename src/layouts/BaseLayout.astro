---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Container from "../components/shell/Container.astro";
import Nav from "../components/shell/Nav.astro";
import ShellLoadBoot from "../components/shell/ShellLoadBoot.astro";
import ShellLoadUX from "../components/shell/ShellLoadUX.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import { ClientRouter, fade } from "astro:transitions";
import { ShellHeader } from "../components/react/header/ShellHeader";
import type { SeoMeta } from "../lib/seo";
import SiteIcon from "../../assets/SiteIcon.png";

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  backHref?: string;
  backLabel?: string;
  fullBleed?: boolean;
  hideRail?: boolean;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  backHref,
  backLabel = "Back",
  fullBleed = false,
  hideRail = false,
} = Astro.props as Props;

const [references, notes, nowEntries] = await Promise.all([
  getCollection("references"),
  getCollection("notes"),
  getCollection("now"),
]);

const brandIcon = await getImage({
  src: SiteIcon,
  width: 64,
  height: 64,
  format: "webp",
});
---

<html
  lang="en"
  data-theme="graphite"
  data-theme-family="graphite"
  data-theme-mode="system"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <ShellLoadBoot />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
    />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <ShellLoadUX />
    <header
      class="motion-page sticky top-0 z-50 pt-3"
      transition:animate="none"
    >
      <div
        class:list={[
          "w-full",
          fullBleed
            ? "px-3 sm:px-5 lg:px-6"
            : "mx-auto max-w-5xl px-3 sm:px-5 lg:px-6",
        ]}
      >
        <ShellHeader
          client:load
          transition:persist
          backHref={backHref}
          backLabel={backLabel}
          brandIcon={brandIcon}
          currentPath={Astro.url.pathname}
          hasReferences={references.length > 0}
          hasNotes={notes.length > 0}
          hasNow={nowEntries.length > 0}
        />
      </div>
    </header>

    {
      fullBleed ? (
        <main
          data-shell-main
          class="motion-page relative z-10 pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
          transition:animate={fade({ duration: "0.24s" })}
        >
          <slot />
        </main>
      ) : hideRail ? (
        <Container>
          <main
            data-shell-main
            class="motion-page relative z-10 min-h-[calc(100svh-7rem)] pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
            transition:animate={fade({ duration: "0.24s" })}
          >
            <slot />
          </main>
        </Container>
      ) : (
        <Container class="lg:grid lg:grid-cols-[auto_minmax(0,1fr)] lg:items-start lg:gap-8">
          <aside class="relative lg:z-20 lg:sticky lg:top-24 lg:pt-4">
            <Nav />
          </aside>

          <main
            data-shell-main
            class="motion-page relative z-10 pb-[calc(7rem+env(safe-area-inset-bottom))] lg:pb-0"
            transition:animate={fade({ duration: "0.24s" })}
          >
            <slot />
          </main>
        </Container>
      )
    }

    <SiteFooter transition:persist transition:name="site-footer" />
  </body>
</html>
