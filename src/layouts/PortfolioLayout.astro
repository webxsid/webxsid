---
import "../styles/portfolio.css";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import PortfolioHeader from "../components/portfolio/PortfolioHeader.astro";
import { portfolio } from "../data/portfolio";
import { portfolioCanonical } from "../lib/portfolio";
import { portfolioOgImagePath } from "../lib/portfolio-og";
const canonical = portfolioCanonical();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: portfolio.name,
  jobTitle: portfolio.role,
  knowsAbout: portfolio.expertiseAreas,
  email: portfolio.email,
  url: canonical,
  sameAs: [portfolio.github, portfolio.linkedin],
};
---

<!doctype html>
<html
  lang="en"
  data-theme="graphite"
  data-theme-family="graphite"
  data-theme-mode="system"
>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="theme-color" content="#121214" /><ThemeBootstrap /><SeoHead
      title={portfolio.seo.title}
      description={portfolio.seo.description}
      pathname="/portfolio"
      seo={{ canonical, image: portfolioOgImagePath, imageWidth: 1200, imageHeight: 630 }}
    /><script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    /></head
  >
  <body
    ><a class="portfolio-skip" href="#main">Skip to content</a><div
      class="portfolio-sheet"
    ><div class="portfolio-col"><PortfolioHeader /><slot /><footer
      class="portfolio-footer">
      <p>© {new Date().getFullYear()} {portfolio.name}</p><a
        class="text-link"
        href="#about">Back to top <span aria-hidden="true">↑</span></a
      >
    </footer></div></div></body
  >
</html>
