---
import "../styles/global.css";
import RailDesktop from "../components/rail/RailDesktop.astro";
import RailDock from "../components/rail/RailDock.astro";
import RailPageShell from "../components/shell/RailPageShell.astro";
import ShellLoadBoot from "../components/shell/ShellLoadBoot.astro";
import ShellLoadUX from "../components/shell/ShellLoadUX.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import { formatNowRailDate } from "../lib/now";
import { ClientRouter } from "astro:transitions";
import type { SeoMeta } from "../lib/seo";

type NowItem = {
  id: string;
  summary: string;
};

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  resourceHints?: string[];
  seoType?: "website" | "article";
  articleSection?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  nowItems: NowItem[];
  activeId: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  resourceHints = [],
  seoType = "article",
  articleSection = "Now",
  articlePublishedTime,
  articleModifiedTime,
  nowItems,
  activeId,
} = Astro.props as Props;

const nowRailItems = nowItems.map((item) => ({
  id: item.id,
  href: `/now/${item.id}`,
  primary: formatNowRailDate(item.id),
  secondary: item.summary,
}));

const sectionLabel = "Now";
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <ShellLoadBoot />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
      resourceHints={resourceHints}
      articleSection={articleSection}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
    />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <ShellLoadUX />
    <RailPageShell
      backHref="/"
      backLabel="Back home"
      sectionLabel={sectionLabel}
  >
      <RailDock
        slot="dock"
        items={nowRailItems}
        activeId={activeId}
        ariaLabel="Now pages"
        mobileDensity="compact"
      />

      <RailDesktop
        slot="rail"
        items={nowRailItems}
        activeId={activeId}
        ariaLabel="Now pages"
        secondaryVariant="summary"
      />

      <slot />
    </RailPageShell>
  </body>
</html>
