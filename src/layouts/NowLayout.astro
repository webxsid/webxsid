---
import "../styles/global.css";
import RailList from "../components/RailList.astro";
import RailPageShell from "../components/RailPageShell.astro";
import SeoHead from "../components/SeoHead.astro";
import { formatNowRailDate } from "../lib/now";
import { ClientRouter } from "astro:transitions";

type NowItem = {
  id: string;
  summary: string;
};

type Props = {
  title?: string;
  description?: string;
  seo?: {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
  };
  seoType?: "website" | "article";
  nowItems: NowItem[];
  activeId: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  seoType = "article",
  nowItems,
  activeId,
} = Astro.props as Props;

const nowRailItems = nowItems.map((item) => ({
  id: item.id,
  href: `/now/${item.id}`,
  primary: formatNowRailDate(item.id),
  secondary: item.summary,
}));
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
    />
    <ClientRouter />
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.dataset.theme = theme;
      }
    </script>
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <RailPageShell backHref="/" backLabel="Back home">
      <RailList
        slot="rail"
        items={nowRailItems}
        activeId={activeId}
        ariaLabel="Now pages"
        secondaryVariant="summary"
        mobileDensity="compact"
      />

      <slot />
    </RailPageShell>
  </body>
</html>
