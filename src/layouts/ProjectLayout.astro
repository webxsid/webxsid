---
import "../styles/global.css";
import RailList from "../components/RailList.astro";
import RailPageShell from "../components/RailPageShell.astro";
import SeoHead from "../components/SeoHead.astro";
import { ClientRouter } from "astro:transitions";

type ProjectItem = {
  id: string;
  title: string;
  status: string;
  updatedAt?: Date;
  order: number;
};

type Props = {
  title?: string;
  description?: string;
  seo?: {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
  };
  seoType?: "website" | "article";
  projectItems: ProjectItem[];
  activeId: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  seoType = "article",
  projectItems,
  activeId,
} = Astro.props as Props;

const formatDate = (value?: Date) =>
  value
    ? value.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
      })
    : null;

const projectRailItems = [...projectItems]
  .sort((a, b) => a.order - b.order)
  .map((item) => ({
    id: item.id,
    href: `/projects/${item.id}`,
    primary: item.title,
    secondary: `${item.status}${formatDate(item.updatedAt) ? ` · ${formatDate(item.updatedAt)}` : ""}`,
  }));

const sectionLabel = "Projects";
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <SeoHead
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
    />
    <ClientRouter />
    <script is:inline>
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.dataset.theme = theme;
      }
    </script>
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <RailPageShell
      backHref="/projects"
      backLabel="Back to projects"
      sectionLabel={sectionLabel}
    >
      <RailList
        slot="rail"
        items={projectRailItems}
        activeId={activeId}
        ariaLabel="Project pages"
        mobileDensity="compact"
      />

      <slot />
    </RailPageShell>
  </body>
</html>
