---
import "../styles/global.css";
import RailDesktop from "../components/rail/RailDesktop.astro";
import RailDock from "../components/rail/RailDock.astro";
import RailPageShell from "../components/shell/RailPageShell.astro";
import ShellLoadBoot from "../components/shell/ShellLoadBoot.astro";
import ShellLoadUX from "../components/shell/ShellLoadUX.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import SeoHead from "../components/shell/SeoHead.astro";
import { ClientRouter } from "astro:transitions";
import type { SeoMeta } from "../lib/seo";

type ProjectItem = {
  id: string;
  title: string;
  status: string;
  updatedAt?: Date;
  order: number;
  yearStarted?: number;
  yearEnded?: number;
  detailsPage?: boolean;
};

type Props = {
  title?: string;
  description?: string;
  seo?: SeoMeta;
  resourceHints?: string[];
  seoType?: "website" | "article";
  articleSection?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  projectItems: ProjectItem[];
  activeId: string;
};

const {
  title = "Webxsid",
  description = "Sid's personal portfolio.",
  seo,
  resourceHints = [],
  seoType = "article",
  articleSection = "Projects",
  articlePublishedTime,
  articleModifiedTime,
  projectItems,
  activeId,
} = Astro.props as Props;

const formatYears = (yearStarted?: number, yearEnded?: number) => {
  if (!yearStarted && !yearEnded) return "";
  if (yearStarted && yearEnded && yearStarted !== yearEnded) {
    return `${yearStarted}–${yearEnded}`;
  }
  if (yearStarted && yearEnded) return `${yearStarted}`;
  if (yearStarted) return `${yearStarted}–`;
  return `–${yearEnded}`;
};

const formatStatus = (status: string) =>
  status.charAt(0).toUpperCase() + status.slice(1);

const projectRailItems = [...projectItems]
  .filter((item) => item.detailsPage !== false)
  .sort((a, b) => a.order - b.order)
  .map((item) => ({
    id: item.id,
    href: `/projects/${item.id}`,
    primary: item.title,
    secondary: [formatStatus(item.status), formatYears(item.yearStarted, item.yearEnded)]
      .filter(Boolean)
      .join(" · "),
  }));

const sectionLabel = "Projects";
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <ShellLoadBoot />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      seo={seo}
      type={seoType}
      resourceHints={resourceHints}
      articleSection={articleSection}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
    />
    <ClientRouter />
    <ThemeBootstrap />
  </head>
  <body
    class="min-h-dvh bg-bg text-text antialiased selection:bg-accent/20 selection:text-text"
  >
    <ShellLoadUX />
    <RailPageShell
      backHref="/projects"
      backLabel="Back to projects"
      sectionLabel={sectionLabel}
    >
      <RailDock
        slot="dock"
        items={projectRailItems}
        activeId={activeId}
        ariaLabel="Project pages"
        mobileDensity="compact"
      />

      <RailDesktop
        slot="rail"
        items={projectRailItems}
        activeId={activeId}
        ariaLabel="Project pages"
      />

      <slot />
    </RailPageShell>
  </body>
</html>
