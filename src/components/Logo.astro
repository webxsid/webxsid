---
type Props = {
  href?: string;
  label?: string;
  class?: string;
};

const {
  href = "/",
  label = "Webxsid",
  class: className = "",
} = Astro.props as Props;

const Shell = href ? "a" : "div";
---

<Shell
  href={href}
  aria-label={label}
  class={`inline-flex items-center gap-3 rounded-full border border-border/70 bg-bg/35 px-3 py-2 text-text backdrop-blur-md transition ${className}`.trim()}
>
  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border/70 bg-bg/55 font-mono text-[11px] uppercase tracking-[0.24em] text-text backdrop-blur-md">
    <slot>WX</slot>
  </span>
  <span class="font-mono text-[11px] uppercase tracking-[0.32em] text-text-muted">
    {label}
  </span>
</Shell>
