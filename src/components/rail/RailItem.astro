---
type Item = {
  id: string;
  href: string;
  primary: string;
  secondary?: string;
};

type Props = {
  item: Item;
  active: boolean;
  variant: "vertical" | "dock";
  secondaryVariant?: "meta" | "summary";
  mobileDensity?: "normal" | "compact";
};

const {
  item,
  active,
  variant,
  secondaryVariant = "meta",
  mobileDensity = "normal",
} = Astro.props as Props;
---

{
  variant === "vertical" ? (
    <a
      href={item.href}
      aria-current={active ? "page" : undefined}
      class="group motion-soft block space-y-2"
    >
      <div class="space-y-1">
        <span
          class={[
            "ui-rail-primary block transition line-clamp-1",
            active ? "text-text" : "text-text-muted group-hover:text-text",
          ].join(" ")}
        >
          {item.primary}
        </span>

        {item.secondary && secondaryVariant === "meta" && (
          <span
            class={[
              "ui-rail-meta block font-mono uppercase",
              active ? "text-text-muted" : "text-text-muted/60",
              "line-clamp-1",
            ].join(" ")}
          >
            {item.secondary}
          </span>
        )}

        {item.secondary && secondaryVariant === "summary" && (
          <p
            class={[
              "ui-rail-summary max-w-[12rem]",
              active ? "text-text-muted" : "text-text-muted/70",
              "line-clamp-2",
            ].join(" ")}
          >
            {item.secondary}
          </p>
        )}
      </div>

      <div
        class={[
          "h-px transition-all duration-300",
          active
            ? "w-[80%] bg-text"
            : "w-8 bg-border/70 group-hover:w-[50%] hover:bg-border/80",
        ].join(" ")}
      />
    </a>
  ) : (
    <a
      href={item.href}
      class={[
        "shell-item motion-surface flex flex-col border text-left",
        mobileDensity === "compact"
          ? "min-w-[9.5rem] max-w-[9.5rem] gap-0.5 px-2.5 py-1.5"
          : "min-w-[11rem] max-w-[11rem] gap-1 px-3 py-2",
        active ? "shell-item-active" : "text-text-muted hover:text-text",
      ].join(" ")}
      style="border-radius: var(--radius-dock);"
    >
      <span
        class={[
          "block truncate leading-5 lint-clamp-1",
          "ui-rail-primary",
        ].join(" ")}
      >
        {item.primary}
      </span>

      {item.secondary && secondaryVariant === "meta" && (
        <span
          class={[
            "ui-rail-meta block truncate font-mono uppercase line-clamp-1",
            active ? "text-text-muted" : "text-text-muted/70",
          ].join(" ")}
        >
          {item.secondary}
        </span>
      )}

      {item.secondary && secondaryVariant === "summary" && (
        <span
          class={[
            "ui-rail-summary block truncate line-clamp-2",
            active ? "text-text-muted" : "text-text-muted/70",
          ].join(" ")}
        >
          {item.secondary}
        </span>
      )}
    </a>
  )
}
