---
import RailItem from "./RailItem.astro";

type Item = {
  id: string;
  href: string;
  primary: string;
  secondary?: string;
};

type Props = {
  items: Item[];
  activeId: string;
  ariaLabel: string;
  secondaryVariant?: "meta" | "summary";
};

const {
  items,
  activeId,
  ariaLabel,
  secondaryVariant = "meta",
} = Astro.props as Props;
---

<aside
  data-rail-scroll
  data-rail-scroll-container
  data-rail-mode="vertical"
  class="hidden lg:block lg:sticky lg:top-20 lg:max-h-[calc(100dvh-4rem)] lg:overflow-y-auto"
>
  <nav aria-label={ariaLabel}>
    <ul class="space-y-6">
      {
        items.map((item) => (
          <li>
            <RailItem
              item={item}
              active={item.id === activeId}
              variant="vertical"
              secondaryVariant={secondaryVariant}
            />
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
