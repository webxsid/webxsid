---
import { footerSocialLinks } from "../../lib/site-links";

const destinations = footerSocialLinks.filter(
  (link) =>
    link.label === "RSS" || link.label === "Threads" || link.label === "GitHub",
);
---

<footer class="max-w-3xl border-t border-border/70 pt-8 sm:pt-10 lg:pt-12">
  <div class="max-w-2xl space-y-4">
    <p class="ui-prose text-text-muted">
      If you enjoy this kind of writing, you can follow along elsewhere.
    </p>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {
        destinations.map((link, index) => (
          <>
            {index > 0 && (
              <span class="ui-meta font-mono text-text-muted">/</span>
            )}
            <a
              href={link.href}
              {...(link.href.startsWith("http")
                ? {
                    target: "_blank",
                    rel: "noopener noreferrer",
                  }
                : {})}
              class="meta-link ui-prose text-text-muted"
            >
              {link.label}
            </a>
          </>
        ))
      }
    </div>
  </div>
</footer>
