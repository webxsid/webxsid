---
import { render } from "astro:content";
import IndexGroup from "./IndexGroup.astro";
import NoteLogEntry from "../notes/NoteLogEntry.astro";
import type { NoteEntry } from "../../lib/notes";

// The latest notes in full, as a short feed, rather than excerpts.
type Props = {
  notes: NoteEntry[];
};

const { notes } = Astro.props as Props;
const entries = await Promise.all(
  notes.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

{entries.length > 0 && (
  <IndexGroup label="Latest notes" id="home-notes" href="/notes" linkLabel="all notes →" pinned={false}>
    <div class="home-notes-feed">
      {entries.map(({ entry, Content }) => (
        <NoteLogEntry entry={entry} Content={Content} showDay />
      ))}
    </div>
    <p class="home-notes-more ui-meta font-mono">
      <a class="index-row-meta-link" href="/notes">view all notes →</a>
    </p>
  </IndexGroup>
)}
