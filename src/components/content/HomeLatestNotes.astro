---
import Section from "./Section.astro";
import {
  formatNoteShortDay,
  formatNoteTime,
  formatNoteTimestamp,
  getNoteExcerpt,
  getNotePath,
  parseNoteTimestamp,
  type NoteEntry,
} from "../../lib/notes";

type Props = {
  notes: NoteEntry[];
};

const { notes } = Astro.props as Props;
---

{notes.length > 0 && (
  <Section title="Latest Notes">
    <ol class="home-notes-log list-none" aria-label="Latest notes">
      {
        notes.map((note) => (
          <li>
            <a
              class="home-notes-log-row"
              href={getNotePath(note)}
              aria-label={`Note from ${formatNoteTimestamp(note)}: ${getNoteExcerpt(note)}`}
            >
              <time
                class="home-notes-log-time ui-meta font-mono"
                datetime={parseNoteTimestamp(note.id).toISOString()}
              >
                <span>{formatNoteShortDay(note)}</span>
                <span>{formatNoteTime(note)}</span>
              </time>
              <p class="home-notes-log-excerpt ui-prose">
                {getNoteExcerpt(note)}
              </p>
            </a>
          </li>
        ))
      }
    </ol>

    <a href="/notes" class="primary-button ui-shell inline-flex items-center transition">
      View all notes
    </a>
  </Section>
)}
