---
type Entry = {
  id: string;
  data: {
    title: string;
    summary: string;
    kind: "blog" | "note";
    publishedAt: Date;
    order: number;
  };
};

type Props = {
  entries: Entry[];
};

const { entries } = Astro.props as Props;
---

<div class="border-t border-border/70">
  {
    [...entries]
      .sort((a, b) => a.data.order - b.data.order)
      .map((entry) => (
        <article class="motion-page motion-surface group py-8">
          <a href={`/writing/${entry.id}`} class="block space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <h3 class="title-link motion-soft">{entry.data.title}</h3>
                <p class="ui-prose max-w-2xl text-text-muted">
                  {entry.data.summary}
                </p>
              </div>

              <span class="ui-meta shrink-0 font-mono uppercase text-text-muted">
                {entry.data.publishedAt.toLocaleDateString(undefined, {
                  month: "short",
                  day: "2-digit",
                  year: "numeric",
                })}
              </span>
            </div>

            <div class="ui-meta flex flex-wrap items-center gap-x-3 gap-y-2 font-mono uppercase text-text-muted">
              <span>Published {entry.data.publishedAt.getFullYear()}</span>
            </div>
          </a>
        </article>
      ))
  }
</div>
