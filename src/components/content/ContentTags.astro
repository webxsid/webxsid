---
type Props = {
  tags?: string[];
};

const { tags = [] } = Astro.props as Props;
const uniqueTags = [...new Map(
  tags
    .map((tag) => tag.trim())
    .filter(Boolean)
    .map((tag) => [tag.toLocaleLowerCase(), tag]),
).values()];
---

{
  uniqueTags.length > 0 && (
    <ul class="content-tags ui-tag text-text-muted" aria-label="Tags">
      {uniqueTags.map((tag) => <li>#{tag}</li>)}
    </ul>
  )
}
