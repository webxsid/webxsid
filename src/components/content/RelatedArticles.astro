---
type RelatedArticle = {
  href: string;
  title: string;
  publishedAt: Date;
  sharedTags: string[];
  linked: boolean;
};

type Props = {
  articles: RelatedArticle[];
};

const { articles } = Astro.props as Props;
---

{
  articles.length > 0 && (
    <section class="motion-page max-w-4xl border-t border-border/70 pt-8 sm:pt-10 lg:pt-12">
      <div class="space-y-4">
        <h2 class="ui-label font-mono uppercase text-text-muted">Related Articles</h2>
        <ul class="divide-y divide-border/70 border-y border-border/70">
          {articles.map((article) => (
            <li class="flex flex-col gap-2 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <a href={article.href} class="title-link ui-link motion-soft">
                {article.title}
              </a>
              <div class="flex shrink-0 flex-wrap items-center gap-x-2 text-text-muted">
                <time class="ui-tag" datetime={article.publishedAt.toISOString()}>
                  {article.publishedAt.toLocaleDateString(undefined, {
                    month: "short",
                    day: "2-digit",
                    year: "numeric",
                  })}
                </time>
                {article.linked && (
                  <span class="ui-tag">· linked</span>
                )}
                {article.sharedTags.length > 0 && (
                  <span class="ui-tag">· {article.sharedTags.join(" · ")}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
