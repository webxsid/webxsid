---
import ContentDocument from "./ContentDocument.astro";
import ContentHeader from "./ContentHeader.astro";
import ContentLinkFooter from "./ContentLinkFooter.astro";
import ContentLinkPreview from "./ContentLinkPreview.astro";
import type { ContentLinkProfile } from "../../lib/content-links";
import { formatDate } from "../../lib/dates";

type Props = {
  eyebrow: string;
  title: string;
  summary: string;
  publishedAt: Date;
  tags?: string[];
  linkProfile?: ContentLinkProfile;
};

const { eyebrow, title, summary, publishedAt, tags = [], linkProfile } = Astro.props as Props;
---

<div class="motion-page max-w-3xl space-y-12 lg:space-y-16" data-content-preview-scope>
  <ContentHeader eyebrow={eyebrow} title={title} summary={summary}>
    <span slot="meta">
      published {formatDate(publishedAt)}
      {tags.length > 0 && (
        <>
          <br />
          <span class="ui-tag">{tags.join(" · ")}</span>
        </>
      )}
    </span>
  </ContentHeader>

  <ContentDocument note class="space-y-4">
    <slot />
  </ContentDocument>

  <ContentLinkFooter profile={linkProfile} />
  <ContentLinkPreview previewLinks={linkProfile?.previewLinks ?? []} />
</div>
