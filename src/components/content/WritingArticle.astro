---
import ContentDocument from "./ContentDocument.astro";
import { formatDate } from "../../lib/dates";

type Props = {
  eyebrow: string;
  title: string;
  summary: string;
  publishedAt: Date;
};

const { eyebrow, title, summary, publishedAt } = Astro.props as Props;
---

<div class="max-w-3xl space-y-12 lg:space-y-16">
  <header class="space-y-7">
    <div class="space-y-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-text-muted">
        {eyebrow}
      </p>

      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-text sm:text-4xl lg:text-5xl lg:leading-[1.08]">
        {title}
      </h1>
    </div>

    <div class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted sm:text-[15px] sm:leading-8">
      <p>{summary}</p>

      <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-text-muted">
        published {formatDate(publishedAt)}
      </p>
    </div>
  </header>

  <ContentDocument note class="space-y-4">
    <slot />
  </ContentDocument>
</div>
