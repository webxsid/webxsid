---
import ContentDocument from "./ContentDocument.astro";
import { formatNowUpdatedAt } from "../../lib/now";

type Props = {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      updatedAt: Date;
    };
  };
};

const { entry } = Astro.props as Props;
---

<div class="max-w-3xl space-y-12 lg:space-y-16">
  <header class="space-y-7">
    <div class="space-y-3">
      <h1
        class="max-w-3xl text-3xl font-semibold tracking-tight text-text sm:text-4xl lg:text-5xl lg:leading-[1.08]"
      >
        {entry.data.title}
      </h1>
    </div>

    <div
      class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted sm:text-[15px] sm:leading-8"
    >
      <p>{entry.data.summary}</p>

      <p
        class="font-mono text-[11px] uppercase tracking-[0.24em] text-text-muted"
      >
        Updated · {formatNowUpdatedAt(entry.data.updatedAt)}
      </p>
    </div>
  </header>

  <ContentDocument class="space-y-4">
    <slot />
  </ContentDocument>
</div>
