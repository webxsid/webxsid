---
import ContentDocument from "./ContentDocument.astro";
import ContentLinkFooter from "./ContentLinkFooter.astro";
import ContentLinkPreview from "./ContentLinkPreview.astro";
import IndexGroup from "./IndexGroup.astro";
import IndexHeader from "./IndexHeader.astro";
import IndexRow from "./IndexRow.astro";
import type { ContentLinkProfile } from "../../lib/content-links";
import { formatDate } from "../../lib/dates";
import { getNowPath, type NowEntry as NowCollectionEntry } from "../../lib/now";

type Props = {
  entry: NowCollectionEntry;
  linkProfile?: ContentLinkProfile;
  // Set on a past snapshot's page: shows a banner pointing at the latest.
  latest?: NowCollectionEntry;
  newer?: NowCollectionEntry;
  older?: NowCollectionEntry;
  earlier?: NowCollectionEntry[];
};

const {
  entry,
  linkProfile,
  latest,
  newer,
  older,
  earlier = [],
} = Astro.props as Props;
const isSnapshot = Boolean(latest && latest.id !== entry.id);
const updated = formatDate(entry.data.updatedAt);

const relatedLinks = [...(entry.data.links ?? [])].sort((a, b) =>
  (a.heading ?? "link").localeCompare(b.heading ?? "link"),
);
const isExternal = (url: string) => /^https?:\/\//.test(url);
const showPager = Boolean(newer || older);
---

<div class="motion-page space-y-12" data-content-preview-scope>
  {
    isSnapshot && latest && (
      <a class="now-snapshot-banner callout-frame ui-meta font-mono" href="/now">
        <span class="callout-legend ui-label font-mono"><span class="callout-dot" aria-hidden="true"></span>snapshot</span>
        <span>An older snapshot from {updated}. See what I'm up to now →</span>
      </a>
    )
  }

  <IndexHeader
    title={isSnapshot ? `Now · ${updated}` : "Now"}
    intro={entry.data.summary}
    prompt={isSnapshot ? `$ now --at ${entry.id}` : "$ now"}
    meta={`updated ${updated}`}
  />

  <ContentDocument class="now-body">
    <slot />
  </ContentDocument>

  {
    relatedLinks.length > 0 && (
      <nav class="now-links index-row-meta ui-meta font-mono" aria-label="Related links">
        {relatedLinks.map((item) => (
          <span>
            {(item.heading ?? "link").toLowerCase()}{" "}
            <a
              class="index-row-meta-link"
              href={item.url}
              {...(isExternal(item.url)
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >{isExternal(item.url) ? `${item.title} ↗` : item.title}</a>
          </span>
        ))}
      </nav>
    )
  }

  <ContentLinkFooter
    profile={linkProfile}
    declaredUrls={relatedLinks.map((item) => item.url)}
  />

  {
    earlier.length > 0 && (
      <IndexGroup label="Earlier updates" id="now-earlier" pinned={false}>
        {earlier.map((snapshot) => (
          <IndexRow
            href={getNowPath(snapshot)}
            title={formatDate(snapshot.data.updatedAt)}
            clamp
          >
            {snapshot.data.summary}
          </IndexRow>
        ))}
      </IndexGroup>
    )
  }

  {
    showPager && (
      <nav class="content-pager ui-meta font-mono" aria-label="More updates">
        {older ? (
          <a href={getNowPath(older)} rel="prev">
            ← older · {formatDate(older.data.updatedAt)}
          </a>
        ) : (
          <span />
        )}
        <a href="/now">latest</a>
        {newer ? (
          <a href={getNowPath(newer)} rel="next">
            newer · {formatDate(newer.data.updatedAt)} →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  <ContentLinkPreview previewLinks={linkProfile?.previewLinks ?? []} />
</div>
