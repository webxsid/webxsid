---
import ContentDocument from "./ContentDocument.astro";
import ContentHeader from "./ContentHeader.astro";
import ContentLinkFooter from "./ContentLinkFooter.astro";
import type { ContentLinkProfile } from "../../lib/content-links";
import { formatNowUpdatedAt } from "../../lib/now";

type Props = {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      updatedAt: Date;
    };
  };
  linkProfile?: ContentLinkProfile;
};

const { entry, linkProfile } = Astro.props as Props;
---

<div class="motion-page max-w-3xl space-y-12 lg:space-y-16">
  <ContentHeader eyebrow="Now" title={entry.data.title} summary={entry.data.summary}>
    <span slot="meta">updated {formatNowUpdatedAt(entry.data.updatedAt)}</span>
  </ContentHeader>

  <ContentDocument class="space-y-4">
    <slot />
  </ContentDocument>

  <ContentLinkFooter profile={linkProfile} />
</div>
