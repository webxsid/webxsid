---
type Props = {
  items?: Array<{
    label: string;
    value: string;
    href?: string;
  }>;
};

const { items = [] } = Astro.props as Props;
---

{
  items.length > 0 && (
    <dl class="content-meta-list" aria-label="Content metadata">
      {items.map((item) => (
        <div class="content-meta-row">
          <dt class="ui-meta font-mono text-text-muted">
            {item.label}
          </dt>
          <dd class="content-meta-value ui-tag text-text">
            {item.href ? (
              <a href={item.href} class="inline-link">
                {item.value}
              </a>
            ) : (
              item.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}
