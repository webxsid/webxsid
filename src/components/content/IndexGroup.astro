---
type Props = {
  label: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  pinned?: boolean;
};

const { label, id, href, linkLabel = "all →", pinned = true } = Astro.props as Props;
---

<section class="index-group" aria-labelledby={id}>
  <div class="index-group-label ui-label font-mono" data-pinned={pinned ? "true" : "false"}>
    <h2 id={id} class="index-group-title">{label}</h2>
    {href && <a class="index-group-link" href={href}>{linkLabel}</a>}
  </div>
  <div class="index-group-items">
    <slot />
  </div>
</section>
