---
type Props = {
  eyebrow?: string;
  title: string;
  summary: string;
  class?: string;
};

const { eyebrow, title, summary, class: className = "" } = Astro.props as Props;
const hasMeta = Astro.slots.has("meta");
---

<header
  class={`motion-page max-w-3xl space-y-7 lg:space-y-8 ${className}`.trim()}
>
  <div class="space-y-3">
    {
      eyebrow && (
        <p class="ui-label font-mono uppercase text-text-muted">{eyebrow}</p>
      )
    }

    <h1 class="ui-title max-w-3xl font-semibold tracking-tight text-text">
      {title}
    </h1>
  </div>

  <div class="ui-prose max-w-2xl space-y-5 text-text-muted">
    <p>{summary}</p>

    {
      hasMeta && (
        <div class="ui-tag uppercase text-text-muted">
          <slot name="meta" />
        </div>
      )
    }
  </div>
</header>
