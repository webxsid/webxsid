---
type Props = {
  eyebrow?: string;
  title: string;
  summary: string;
  class?: string;
};

const { eyebrow, title, summary, class: className = "" } = Astro.props as Props;
const hasMeta = Astro.slots.has("meta");
---

<header class={`motion-page max-w-3xl space-y-7 lg:space-y-8 ${className}`.trim()}>
  <div class="space-y-3">
    {eyebrow && (
      <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-text-muted">
        {eyebrow}
      </p>
    )}

    <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-text sm:text-4xl lg:text-5xl lg:leading-[1.08]">
      {title}
    </h1>
  </div>

  <div class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted sm:text-[15px] sm:leading-8">
    <p>{summary}</p>

    {
      hasMeta && (
        <div class="font-mono text-[11px] uppercase tracking-[0.24em] text-text-muted">
          <slot name="meta" />
        </div>
      )
    }
  </div>
</header>
