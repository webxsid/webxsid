---
type Props = {
  status: string;
  class?: string;
};

const { status, class: className } = Astro.props as Props;

const tone = `status-${status.toLowerCase().replace(/\s+/g, "-")}`;
---

<span
  class={`status-badge motion-soft ui-shell inline-flex items-center font-mono uppercase ${tone} ${className ?? ""}`.trim()}
>
  {status}
</span>
