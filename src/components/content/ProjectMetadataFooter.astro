---
import type { ContentLinkProfile } from "../../lib/content-links";

type Props = {
  profile?: ContentLinkProfile;
  declaredUrls?: string[];
};

const { profile, declaredUrls = [] } = Astro.props as Props;

const normalizeExternalLink = (value: string) => {
  try {
    const url = new URL(value);
    const pathname = url.pathname.replace(/\/+$/, "") || "/";
    return `${url.origin}${pathname}${url.search}`;
  } catch {
    return value;
  }
};

const getDisplayUrl = (value: string) => {
  try {
    const url = new URL(value);
    const pathname = url.pathname.replace(/\/+$/, "");
    return `${url.hostname.replace(/^www\./, "")}${pathname}${url.search}`;
  } catch {
    return value;
  }
};

const groupItems = <T,>(items: T[], getKey: (item: T) => string) => {
  const groups = new Map<string, T[]>();

  for (const item of items) {
    const key = getKey(item);
    const bucket = groups.get(key);

    if (bucket) {
      bucket.push(item);
      continue;
    }

    groups.set(key, [item]);
  }

  return [...groups.entries()].map(([label, items]) => ({ label, items }));
};

const backlinkGroups = groupItems(
  profile?.backlinks ?? [],
  (item) => item.section,
).map((group) => ({
  ...group,
  count: group.items.length,
}));

const declaredUrlSet = new Set(declaredUrls.map(normalizeExternalLink));
const filteredReferences = (profile?.references ?? []).filter(
  (item) => !declaredUrlSet.has(normalizeExternalLink(item.href)),
);

const seenReferenceUrls = new Set<string>();
const externalReferences = filteredReferences.filter((item) => {
  const normalized = normalizeExternalLink(item.href);
  if (seenReferenceUrls.has(normalized)) return false;
  seenReferenceUrls.add(normalized);
  return true;
});

const hasConnectedWriting = backlinkGroups.length > 0;
const hasExternalReferences = externalReferences.length > 0;
---

{
  (hasConnectedWriting || hasExternalReferences) && (
    <footer class="motion-page max-w-4xl border-t border-border/70 pt-8 sm:pt-10 lg:pt-12">
      <div class="space-y-8 sm:space-y-10">
        {hasConnectedWriting && (
          <section class="space-y-4">
            <p class="ui-label font-mono uppercase text-text-muted">
              Connected Writing
            </p>

            <div class="overflow-x-auto">
              <table class="w-full border-separate border-spacing-0">
                <tbody>
                  {backlinkGroups.map((group) => (
                    <tr class="align-top">
                      <td class="ui-table block w-full pb-2 pr-0 font-mono uppercase text-text-muted md:table-cell md:w-[11rem] md:pb-4 md:pr-8">
                        {group.label} ({group.count})
                      </td>
                      <td class="block pb-5 md:table-cell md:pb-4">
                        <div class="space-y-1.5">
                          {group.items.map((item) => (
                            <div>
                              <a
                                href={item.href}
                                class="meta-link text-text"
                              >
                                {item.label}
                              </a>
                            </div>
                          ))}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {hasExternalReferences && (
          <section class="space-y-4">
            <p class="ui-label font-mono uppercase text-text-muted">
              External References
            </p>

            <div class="overflow-x-auto">
              <table class="w-full border-separate border-spacing-0">
                <tbody>
                  {externalReferences.map((item) => (
                    <tr class="align-top">
                      <td class="ui-table block w-full pb-2 pr-0 font-mono uppercase text-text-muted md:table-cell md:w-[11rem] md:pb-4 md:pr-8">
                        {item.origin}
                      </td>
                      <td class="block pb-5 md:table-cell md:pb-4">
                        <div class="space-y-1.5">
                          <p class="ui-prose text-text">
                            <a
                              href={item.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="meta-link"
                            >
                              {item.displayUrl || getDisplayUrl(item.href)}
                            </a>
                          </p>

                          {item.description && (
                            <p class="ui-rail-summary max-w-xl text-text-muted">
                              {item.description}
                            </p>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    </footer>
  )
}
