---
import { Image } from "astro:assets";
import ProjectArtifact from "./ProjectArtifact.astro";
import type { ProjectMedia } from "../../lib/projects";

type Props = {
  items: ProjectMedia[];
};

const { items } = Astro.props as Props;
---

{
  items.length > 0 && (
    <div class="shot-stack" style={`--count: ${items.length}`}>
      {items.map((item, index) => (
        <figure
          class="project-shot shot-stack-card"
          data-variant="thumb"
          style={`--i: ${index}`}
        >
          {item.type === "image" ? (
            <Image
              src={item.src}
              alt={item.alt}
              widths={[320, 480, 640, 1280]}
              sizes="14rem"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <ProjectArtifact artifact={item.artifact} />
          )}
        </figure>
      ))}
    </div>
  )
}
