---
import type { ContentLinkProfile } from "../../lib/content-links";

type Props = {
  profile?: ContentLinkProfile;
  // Links the page already shows elsewhere (e.g. a project's source/site).
  declaredUrls?: string[];
  showConnectedWriting?: boolean;
  // Render only the groups, inside a caller's .link-footer.
  embedded?: boolean;
};

const {
  profile,
  declaredUrls = [],
  showConnectedWriting = true,
  embedded = false,
} = Astro.props as Props;

const maxPathLength = 32;
const mediaPattern = /\.(gif|png|jpe?g|webp|avif|svg|mp4|webm|mov)$/i;

const normalizeExternalLink = (value: string) => {
  try {
    const url = new URL(value);
    const pathname = url.pathname.replace(/\/+$/, "") || "/";
    return `${url.origin}${pathname}${url.search}`;
  } catch {
    return value;
  }
};

// "media0.giphy.com/media/v1.Y2lk…/giphy.gif" style: host plus a capped path.
const getShortUrl = (value: string) => {
  try {
    const url = new URL(value);
    const host = url.hostname.replace(/^www\./, "");
    const path = url.pathname.replace(/\/+$/, "");
    if (!path) return host;

    return path.length > maxPathLength
      ? `${host}${path.slice(0, maxPathLength - 1)}…`
      : `${host}${path}`;
  } catch {
    return value;
  }
};

const isMediaLink = (href: string, kind: string) => {
  if (kind === "image" || kind === "video") return true;

  try {
    return mediaPattern.test(new URL(href).pathname);
  } catch {
    return false;
  }
};

const backlinks = showConnectedWriting ? (profile?.backlinks ?? []) : [];

const declaredUrlSet = new Set(declaredUrls.map(normalizeExternalLink));
const seenReferenceUrls = new Set<string>();
const references = (profile?.references ?? []).filter((item) => {
  const normalized = normalizeExternalLink(item.href);
  if (declaredUrlSet.has(normalized) || seenReferenceUrls.has(normalized)) {
    return false;
  }
  if (isMediaLink(item.href, item.kind)) return false;

  seenReferenceUrls.add(normalized);
  return true;
});
const Wrapper = embedded ? Fragment : "footer";
const wrapperProps = embedded ? {} : { class: "link-footer motion-page" };
---

{
  (backlinks.length > 0 || references.length > 0) && (
    <Wrapper {...wrapperProps}>
      {backlinks.length > 0 && (
        <section class="link-footer-group">
          <h2 class="link-footer-label ui-label font-mono">Mentioned in</h2>
          <ul class="link-footer-items">
            {backlinks.map((item) => (
              <li class="ui-meta font-mono">
                <span class="link-footer-kind">{item.section.toLowerCase()}</span>
                <a class="index-row-meta-link" href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {references.length > 0 && (
        <section class="link-footer-group">
          <h2 class="link-footer-label ui-label font-mono">References</h2>
          <ul class="link-footer-items">
            {references.map((item) => (
              <li class="ui-meta font-mono">
                <a
                  class="index-row-meta-link"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >{`${getShortUrl(item.href)} ↗`}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </Wrapper>
  )
}
