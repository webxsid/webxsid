---
type Props = {
  level?: 1 | 2 | 3;
  class?: string;
};

const { level = 2, class: className = "" } = Astro.props as Props;
const Tag = `h${level}` as const;
---

<Tag class={`tracking-tight text-text ${level === 1 ? "text-4xl font-semibold sm:text-5xl" : level === 2 ? "text-lg font-semibold" : "text-base font-medium"} ${className}`.trim()}>
  <slot />
</Tag>
