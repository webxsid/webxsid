---
import type { render } from "astro:content";
import ContentDocument from "../content/ContentDocument.astro";
import {
  formatNoteShortDay,
  formatNoteTime,
  formatNoteTimestamp,
  getNotePath,
  parseNoteTimestamp,
  type NoteEntry,
} from "../../lib/notes";

type Props = {
  entry: NoteEntry;
  Content: Awaited<ReturnType<typeof render>>["Content"];
  current?: boolean;
  /** Show the day above the time, for feeds that aren't grouped by day. */
  showDay?: boolean;
};

const { entry, Content, current = false, showDay = false } = Astro.props as Props;
---

<article
  class="notes-log-entry"
  id={`note-${entry.id}`}
  data-show-day={showDay ? "true" : undefined}
>
  <a
    class="notes-log-time ui-meta font-mono"
    href={getNotePath(entry)}
    aria-current={current ? "page" : undefined}
    aria-label={`Permalink: note from ${formatNoteTimestamp(entry)}`}
  >
    <time datetime={parseNoteTimestamp(entry.id).toISOString()}>
      {showDay && <span>{formatNoteShortDay(entry)}</span>}
      <span>{formatNoteTime(entry)}</span>
    </time>
  </a>

  <ContentDocument class="notes-log-body">
    <Content />
  </ContentDocument>
</article>
