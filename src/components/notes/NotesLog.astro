---
import { getCollection, render } from "astro:content";
import ContentLinkPreview from "../content/ContentLinkPreview.astro";
import IndexGroup from "../content/IndexGroup.astro";
import IndexHeader from "../content/IndexHeader.astro";
import NoteLogEntry from "./NoteLogEntry.astro";
import { getContentLinkProfiles } from "../../lib/content-links";
import { getNotePath, groupNotesByDay, sortNotes } from "../../lib/notes";

const notes = sortNotes(await getCollection("notes"));
const linkProfiles = await getContentLinkProfiles();
const contentById = new Map(
  await Promise.all(
    notes.map(async (entry) => [entry.id, (await render(entry)).Content] as const),
  ),
);
const days = groupNotesByDay(notes);
const previewLinks = notes.flatMap(
  (entry) => linkProfiles.get(getNotePath(entry))?.previewLinks ?? [],
);
const entryCount = `${notes.length} ${notes.length === 1 ? "entry" : "entries"}`;
---

<section class="notes-log space-y-10">
  <IndexHeader
    title="Notes"
    intro="Short notes and ideas I want to come back to."
    prompt="$ notes --log"
    meta={entryCount}
  />

  <div class="index-groups">
    {
      days.map((day) => (
        <IndexGroup label={day.label} id={`notes-${day.key}`}>
          {day.notes.map((entry) => (
            <NoteLogEntry entry={entry} Content={contentById.get(entry.id)!} />
          ))}
        </IndexGroup>
      ))
    }
  </div>
</section>

<ContentLinkPreview previewLinks={previewLinks} />
