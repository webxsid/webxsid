---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import { ArrowLeft } from "lucide-astro";

type Props = {
  backHref: string;
  backLabel: string;
};

const { backHref, backLabel } = Astro.props as Props;
---

<header class="sticky top-0 z-50 pt-3">
  <Container>
    <div class="flex items-center justify-start gap-3">
      <a
        href={backHref}
        aria-label={backLabel}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border/70 bg-bg/35 text-text-muted backdrop-blur-md transition hover:border-border hover:bg-bg-elevated/40 hover:text-text"
      >
        <ArrowLeft size={14} aria-hidden="true" />
      </a>

      <Logo />
    </div>
  </Container>
</header>

<Container class="py-4 lg:py-6">
  <div class="space-y-8 lg:space-y-10">
    <div
      class="grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:items-start lg:gap-12"
    >
      <slot name="rail" />

      <main class="min-w-0 pb-[calc(10rem+env(safe-area-inset-bottom))] lg:pb-0">
        <slot />
      </main>
    </div>
  </div>
</Container>
