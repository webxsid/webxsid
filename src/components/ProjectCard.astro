---
import StatusBadge from "./StatusBadge.astro";

type Props = {
  id: string;
  title: string;
  summary: string;
  status: string;
  stack: string[];
  updatedAt?: Date;
};

const { id, title, summary, status, stack, updatedAt } = Astro.props as Props;
---

<article
  class="rounded-2xl border border-border/80 bg-bg-elevated/30 p-4 transition-colors hover:bg-bg-elevated/50"
>
  <a href={`/projects/${id}`} class="group block space-y-3">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-2">
        <h3
          class="font-mono text-sm uppercase tracking-[0.22em] text-text transition-colors group-hover:text-accent"
        >
          {title}
        </h3>
        <p class="text-sm leading-6 text-text-muted">{summary}</p>
      </div>

      <StatusBadge status={status} />
    </div>

    <dl class="grid gap-2 text-sm text-text-muted sm:grid-cols-3">
      <div class="flex items-center justify-between gap-3 sm:block">
        <dt class="font-mono uppercase tracking-[0.24em] text-text-muted">
          Stack
        </dt>
        <dd class="font-mono text-text">
          {
            stack.map((tech, index) => (
              <span
                key={index}
                class="inline-flex items-center px-2 py-1 text-xs text-text-muted border border-border rounded-full"
              >
                {tech}
              </span>
            ))
          }
        </dd>
      </div>
      {
        updatedAt && (
          <div class="flex items-center justify-between gap-3 sm:block">
            <dt class="font-mono uppercase tracking-[0.24em] text-text-muted">
              Last Updated
            </dt>
            <dd class="font-mono text-text">
              {new Date(updatedAt).toLocaleDateString(undefined, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </dd>
          </div>
        )
      }
    </dl>
  </a>
</article>
