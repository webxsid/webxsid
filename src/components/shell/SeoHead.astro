---
import { SITE_URL } from "../../lib/site";

type SeoMeta = {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  noindex?: boolean;
};

type Props = {
  title: string;
  description?: string;
  pathname: string;
  seo?: SeoMeta;
  type?: "website" | "article";
  keywords?: string[];
  articleTags?: string[];
  resourceHints?: string[];
  articleSection?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
};

const {
  title,
  description = "",
  pathname,
  seo,
  type = "website",
  keywords = [],
  articleTags = [],
  resourceHints = [],
  articleSection,
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props as Props;

const pageTitle = seo?.title ?? title;
const pageDescription = seo?.description ?? description;
const canonical = new URL(seo?.canonical ?? pathname, SITE_URL).toString();
const image = seo?.image?.trim()
  ? new URL(seo.image, SITE_URL).toString()
  : null;
const imageWidth = seo?.imageWidth;
const imageHeight = seo?.imageHeight;
const robots = seo?.noindex ? "noindex, nofollow" : "index, follow";
const author = "Siddharth Mittal";
const rssUrl = new URL("/rss.xml", SITE_URL).toString();
const keywordContent = [...new Set(keywords.map((value) => value.trim()).filter(Boolean))].join(", ");
const normalizedArticleTags = [...new Set(articleTags.map((value) => value.trim()).filter(Boolean))];
---

<title>{pageTitle}</title>
<link rel="icon" href="/favicon.ico" sizes="any" />
<meta name="description" content={pageDescription} />
<meta name="author" content={author} />
{keywordContent && <meta name="keywords" content={keywordContent} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Webxsid RSS" href={rssUrl} />
<meta name="robots" content={robots} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Webxsid" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
{
  image && <meta property="og:image" content={image} />
}
{
  image && <meta property="og:image:alt" content={pageTitle} />
}
{
  image && imageWidth && imageHeight && (
    <>
      <meta property="og:image:width" content={String(imageWidth)} />
      <meta property="og:image:height" content={String(imageHeight)} />
      <meta property="og:image:type" content="image/png" />
    </>
  )
}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{
  image && <meta name="twitter:image" content={image} />
}
{
  image && <meta name="twitter:image:alt" content={pageTitle} />
}
{
  type === "article" && articleSection && <meta property="article:section" content={articleSection} />
}
{
  type === "article" && <meta property="article:author" content={author} />
}
{
  type === "article" &&
    normalizedArticleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))
}
{
  type === "article" && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )
}
{
  type === "article" && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )
}
{
  [...new Set(resourceHints)].map((origin) => {
    const parsed = new URL(origin);

    return (
      <>
        <link rel="dns-prefetch" href={`//${parsed.host}`} />
        <link rel="preconnect" href={parsed.origin} crossorigin="anonymous" />
      </>
    );
  })
}
