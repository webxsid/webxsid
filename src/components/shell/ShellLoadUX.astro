<div data-splash-overlay aria-hidden="true">
  <div data-splash-loader>
    <span data-splash-glyph>/</span>
    <span data-splash-label>Webxsid</span>
  </div>
</div>

<div data-route-progress aria-hidden="true"></div>
<div data-theme-refresh-overlay aria-hidden="true"></div>

<script is:inline>
  (() => {
    if (window.__webxsidShellUxInitialized) return;
    window.__webxsidShellUxInitialized = true;

    const root = document.documentElement;
    const minSplashDuration = 320;
    let themeFxTimeout;

    const finishSplash = () => {
      if (root.dataset.splash === "done") return;

      const startedAt = window.__webxsidSplashStartedAt ?? performance.now();
      const elapsed = performance.now() - startedAt;
      const delay = Math.max(0, minSplashDuration - elapsed);

      window.setTimeout(() => {
        root.dataset.splash = "done";
      }, delay);
    };

    const markRouteLoading = (value) => {
      root.dataset.routeLoading = value ? "true" : "false";
    };

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const triggerThemeFx = () => {
      if (prefersReducedMotion()) return;
      const family = root.dataset.themeFamily;
      if (!family || !["e-ink", "graphite", "phosphor", "retro", "doodle"].includes(family))
        return;

      root.dataset.themeFx = "idle";

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          root.dataset.themeFx = "active";
        });
      });

      window.clearTimeout(themeFxTimeout);
      themeFxTimeout = window.setTimeout(() => {
        if (root.dataset.themeFx === "active") {
          delete root.dataset.themeFx;
        }
      }, 360);
    };

    window.__webxsidTriggerThemeFx = triggerThemeFx;

    const afterInitialPaint = () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          finishSplash();
        });
      });
    };

    if (document.readyState === "complete") {
      afterInitialPaint();
    } else {
      window.addEventListener("load", afterInitialPaint, { once: true });
    }

    document.addEventListener("astro:before-preparation", () => {
      markRouteLoading(true);
    });

    document.addEventListener("astro:page-load", () => {
      markRouteLoading(false);
      finishSplash();
      triggerThemeFx();
    });
  })();
</script>
