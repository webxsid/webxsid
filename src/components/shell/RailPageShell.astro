---
import { getImage } from "astro:assets";
import Container from "./Container.astro";
import { ShellHeader } from "../react/header/ShellHeader";
import SiteIcon from "../../../assets/SiteIcon.png";

type Props = {
  backHref: string;
  backLabel: string;
  sectionLabel: string;
};

const { backHref, backLabel, sectionLabel } = Astro.props as Props;

const brandIcon = await getImage({
  src: SiteIcon,
  width: 64,
  height: 64,
  format: "webp",
});
---

<header class="sticky top-0 z-50 pt-3">
  <Container>
    <ShellHeader
      client:load
      transition:persist
      backHref={backHref}
      backLabel={backLabel}
      brandIcon={brandIcon}
      variant="rail"
      pageTitle={sectionLabel}
      currentPath={Astro.url.pathname}
    />
  </Container>
</header>

<Container class="py-4 lg:py-6">
  <div class="space-y-8 lg:space-y-10">
    <div
      class="grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:items-start lg:gap-12"
    >
      <slot name="rail" />

      <main class="min-w-0 pb-[calc(10rem+env(safe-area-inset-bottom))] lg:pb-0">
        <slot />
      </main>
    </div>
  </div>
</Container>
