---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Container from "./Container.astro";
import { ShellHeader } from "../react/header/ShellHeader";
import SiteIcon from "../../../assets/SiteIcon.png";

type Props = {
  backHref: string;
  backLabel: string;
  sectionLabel: string;
};

const { backHref, backLabel, sectionLabel } = Astro.props as Props;

const [references, notes, nowEntries] = await Promise.all([
  getCollection("references"),
  getCollection("notes"),
  getCollection("now"),
]);

const brandIcon = await getImage({
  src: SiteIcon,
  width: 64,
  height: 64,
  format: "webp",
});
---

<header class="motion-page sticky top-0 z-50 pt-3">
  <Container>
    <ShellHeader
      client:load
      transition:persist
      backHref={backHref}
      backLabel={backLabel}
      brandIcon={brandIcon}
      variant="rail"
      pageTitle={sectionLabel}
      currentPath={Astro.url.pathname}
      hasReferences={references.length > 0}
      hasNotes={notes.length > 0}
      hasNow={nowEntries.length > 0}
    />
  </Container>
</header>

<slot name="dock" />

<Container class="motion-page py-4 lg:py-6">
  <div class="space-y-8 lg:space-y-10">
    <div
      class="grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:items-start lg:gap-12"
    >
      <slot name="rail" />

      <main
        data-rail-shell-main
        class="motion-page min-w-0 pb-[calc(10rem+env(safe-area-inset-bottom))] lg:pb-0"
      >
        <slot />
      </main>
    </div>
  </div>
</Container>

<script>
  import { setupRailRestore } from "../rail/rail-restore";

  setupRailRestore();
</script>
