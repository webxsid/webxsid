---
import {
  BookOpenText,
  BookHeart,
  Clock3,
  NotepadText,
  House,
  BriefcaseBusiness,
} from "lucide-astro";
import { getCollection } from "astro:content";
import { filterSharedNavItems, globalNavItems } from "../../lib/site-links";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const [references, notes, nowEntries] = await Promise.all([
  getCollection("references"),
  getCollection("notes"),
  getCollection("now"),
]);
const navItems = filterSharedNavItems(globalNavItems, {
  hasReferences: references.length > 0,
  hasNotes: notes.length > 0,
  hasNow: nowEntries.length > 0,
});

function isActive(href: string) {
  const normalized = href.replace(/\/+$/, "") || "/";

  if (normalized === "/") {
    return pathname === "/";
  }

  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}

const iconsMap = {
  house: House,
  briefcase: BriefcaseBusiness,
  book: BookOpenText,
  bookmark: BookHeart,
  notepad: NotepadText,
  clock: Clock3,
};

const getIconComponent = (icon: keyof typeof iconsMap) => {
  return iconsMap[icon] || Clock3;
};
---

<nav
  aria-label="Primary"
  class="fixed bottom-[calc(0.75rem+env(safe-area-inset-bottom)+var(--dock-viewport-offset,0px))] left-1/2 z-50 flex -translate-x-1/2 items-center justify-center px-3 lg:relative lg:bottom-auto lg:left-auto lg:translate-x-0 lg:justify-start lg:px-0"
>
  <div
    class="shell-nav-frame inline-flex flex-row items-center gap-1 p-1 lg:flex-col"
  >
    {
      navItems.map(({ href, label, icon }) => {
        const active = isActive(href);
        const Icon = getIconComponent(icon);

        return (
          <a
            href={href}
            aria-label={label}
            aria-current={active ? "page" : undefined}
            class={[
              "shell-control shell-item motion-surface group relative inline-flex h-10 w-10 items-center justify-center border",
              active
                ? "shell-item-active"
                : "border-transparent text-text-muted hover:text-text",
            ].join(" ")}
          >
            <Icon size={16} strokeWidth={1.9} aria-hidden="true" />
            <span class="sr-only">{label}</span>
            <label class="shell-tooltip ui-tag pointer-events-none absolute left-[120%] w-max px-4 py-1 text-text opacity-0 group-hover:opacity-100 transition-opacity z-[1000]">
              {label}
            </label>
          </a>
        );
      })
    }
  </div>
</nav>
