---
import Container from "./Container.astro";
import { getCollection } from "astro:content";
import { Github, Instagram, Mail, Rss } from "lucide-astro";
import BlueskyIcon from "../icons/BlueskyIcon.astro";
import ThreadsIcon from "../icons/ThreadsIcon.astro";
import {
  filterSharedNavItems,
  footerColophon,
  footerLinkColumns,
  footerSocialLinks,
} from "../../lib/site-links";

const currentYear = new Date().getFullYear();
const [references, notes, nowEntries] = await Promise.all([
  getCollection("references"),
  getCollection("notes"),
  getCollection("now"),
]);
const footerColumns = footerLinkColumns.map((column) => ({
  label: column.label,
  links: filterSharedNavItems(
    column.links as readonly { href: string; label: string }[],
    {
      hasReferences: references.length > 0,
      hasNotes: notes.length > 0,
      hasNow: nowEntries.length > 0,
    },
  ),
}));
---

<footer class="mt-24 border-t border-border/45 sm:mt-28">
  {/* Below lg the floating dock sits over the page end, so leave room for it. */}
  <Container
    class="pt-14 pb-[calc(6.5rem+env(safe-area-inset-bottom))] sm:pt-16 lg:py-20"
  >
    <div
      class="grid gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-20"
    >
      <div class="max-w-md space-y-7">
        <p class="footer-title max-w-md tracking-tight text-text">
          Still building,<br />
          still learning.
        </p>

        <nav aria-label="Social links">
          <ul class="flex flex-wrap items-center gap-3">
            {
              footerSocialLinks.map(({ href, label, icon }) => {
                const Icon =
                  icon === "github"
                    ? Github
                    : icon === "threads"
                      ? ThreadsIcon
                      : icon === "bluesky"
                        ? BlueskyIcon
                        : icon === "instagram"
                          ? Instagram
                          : icon === "mail"
                            ? Mail
                            : Rss;

                return (
                  <li>
                    <a
                      href={href}
                      target={href.startsWith("http") ? "_blank" : undefined}
                      rel={
                        href.startsWith("http")
                          ? "noopener noreferrer"
                          : undefined
                      }
                      aria-label={label}
                      class="motion-soft inline-flex h-9 w-9 items-center justify-center text-text-muted hover:text-text focus-visible:text-text"
                    >
                      <Icon size={18} strokeWidth={1.8} aria-hidden="true" />
                      <span class="sr-only">{label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>

      <nav
        aria-label="Footer links"
        class="grid grid-cols-2 gap-x-10 gap-y-8 self-start"
      >
        {
          footerColumns.map((column) => (
            <section class="space-y-4">
              <h2 class="link-footer-label ui-label">{column.label}</h2>
              <ul class="space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="motion-soft footer-nav-link font-mono text-text-muted hover:text-text"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </div>

    <p
      class="site-footer-bar index-row-meta ui-meta font-mono mt-14 border-t border-dashed border-border/45 pt-6"
    >
      <span>&copy; <span class="site-footer-year" data-time-year={currentYear}>{currentYear}</span> Siddharth Mittal</span>
      <span>{footerColophon}</span>
      <a class="index-row-meta-link" href="/colophon">colophon →</a>
    </p>
  </Container>
</footer>

<script>
  // Easter egg: tap the year five times and it rolls back to 1999, along with
  // the site (the hidden 1999 theme). In 1999, one tap returns to the present.
  import {
    applyThemePreference,
    resolveThemeFamilyAndMode,
    THEME_BEFORE_UNLOCK_STORAGE_KEY,
    THEME_UNLOCKED_STORAGE_KEY,
  } from "../react/header/header-utils";

  const PAST = 1999;
  const TAPS = 5;
  const IDLE_MS = 2500;

  const read = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };

  const write = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* The trip still works for this page. */
    }
  };

  const inPast = () => document.documentElement.dataset.themeFamily === "web99";

  const initTimeYear = () => {
    const year = document.querySelector<HTMLElement>("[data-time-year]");
    if (!year || year.dataset.ready) return;
    year.dataset.ready = "true";

    const present = Number(year.dataset.timeYear);
    let taps = 0;
    let idle: number | undefined;
    let rolling = false;

    const show = (value: number) => {
      year.textContent = String(value);
    };
    show(inPast() ? PAST : present);

    const travel = () => {
      const root = document.documentElement;
      const current = resolveThemeFamilyAndMode(root.dataset.themeFamily, root.dataset.themeMode);
      write(THEME_BEFORE_UNLOCK_STORAGE_KEY, current.family);
      write(THEME_UNLOCKED_STORAGE_KEY, "1");
      root.dataset.themeUnlocked = "true";
      applyThemePreference("web99", current.mode);
      window.__webxsidTriggerThemeFx?.();
    };

    const returnToPresent = () => {
      const root = document.documentElement;
      const current = resolveThemeFamilyAndMode(root.dataset.themeFamily, root.dataset.themeMode);
      const previous = resolveThemeFamilyAndMode(read(THEME_BEFORE_UNLOCK_STORAGE_KEY), current.mode);
      applyThemePreference(previous.family === "web99" ? "graphite" : previous.family, current.mode);
      window.__webxsidTriggerThemeFx?.();
      show(present);
    };

    // The last tap spins the year down to 1999, then the site follows.
    const roll = () => {
      rolling = true;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let value = present - (TAPS - 1);
      if (reduce) {
        show(PAST);
        travel();
        rolling = false;
        return;
      }
      const step = () => {
        value -= 1;
        show(value);
        if (value > PAST) {
          window.setTimeout(step, 45);
        } else {
          travel();
          rolling = false;
        }
      };
      step();
    };

    year.addEventListener("click", () => {
      if (rolling) return;
      window.clearTimeout(idle);

      if (inPast()) {
        taps = 0;
        returnToPresent();
        return;
      }

      taps += 1;
      if (taps >= TAPS) {
        taps = 0;
        roll();
        return;
      }

      show(present - taps);
      idle = window.setTimeout(() => {
        taps = 0;
        show(present);
      }, IDLE_MS);
    });
  };

  initTimeYear();
  document.addEventListener("astro:page-load", initTimeYear);
</script>

