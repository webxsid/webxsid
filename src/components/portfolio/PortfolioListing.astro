---
type Entry = {
  title: string;
  description: string;
  href: string;
  label: string;
  technologies?: string[];
  featured?: boolean;
};
type Props = { entries: Entry[]; headingLevel?: "h2" | "h3" };
const { entries, headingLevel: Heading = "h2" } = Astro.props;
---

<div class="portfolio-listing">
  {
    entries.map((entry, index) => (
      <article class="portfolio-listing-entry">
        <span class="case-index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <div>
          <>
            <p class="eyebrow">
              {entry.label}
              {entry.featured && " / Selected"}
            </p>
            <Heading>
              <a href={entry.href}>
                {entry.title}
                <span aria-hidden="true">↗</span>
              </a>
            </Heading>
          </>
        </div>
        <div>
          <p class="muted">{entry.description}</p>
          {entry.technologies && (
            <ul class="stack" aria-label={`${entry.title} technologies`}>
              {entry.technologies.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          <a class="text-link" href={entry.href}>
            Explore {entry.title}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))
  }
</div>
