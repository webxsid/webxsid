---
import { themeFamilies, themeModes } from "../react/header/header-utils";
---

<details class="portfolio-theme-picker">
  <summary aria-label="Choose theme" title="Choose theme">
    <svg
      data-mode-icon="system"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="13" rx="2"></rect>
      <path d="M12 17v4m-4 0h8"></path>
    </svg>
    <svg
      data-mode-icon="light"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
      ></path>
    </svg>
    <svg
      data-mode-icon="dark"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z"
      ></path>
    </svg>
  </summary>
  <div class="portfolio-theme-panel">
    <div class="theme-panel-heading">
      <span>Make yourself at home.</span><button
        type="button"
        class="theme-close"
        aria-label="Close theme picker">×</button
      >
    </div>
    <fieldset>
      <legend>Palette</legend>
      <div class="theme-palettes">
        {
          themeFamilies.map((theme) => (
            <label class="theme-palette">
              <input
                type="radio"
                name="portfolio-palette"
                value={theme.value}
              />
              <span
                class="theme-swatch"
                data-family={theme.value}
                data-theme={theme.value === "graphite" ? "paper" : theme.value}
                aria-hidden="true"
              >
                <>
                  <span>Aa</span>
                  <i />
                  <i />
                </>
              </span>
              <span class="theme-palette-name">
                {theme.label}
                <span class="theme-check" aria-hidden="true">
                  ✓
                </span>
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend>Appearance</legend>
      <div class="theme-modes">
        {
          themeModes.map((mode) => (
            <label>
              <>
                <input
                  type="radio"
                  name="portfolio-appearance"
                  value={mode.value}
                />
                <span>{mode.label}</span>
              </>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>
</details>

<script>
  import {
    getThemeColor,
    resolveThemeFamilyAndMode,
    resolveThemeVariant,
    THEME_FAMILY_STORAGE_KEY,
    THEME_MODE_STORAGE_KEY,
  } from "../react/header/header-utils";

  const picker = document.querySelector<HTMLDetailsElement>(
    ".portfolio-theme-picker",
  );
  const families = [
    ...document.querySelectorAll<HTMLInputElement>(
      'input[name="portfolio-palette"]',
    ),
  ];
  const modes = [
    ...document.querySelectorAll<HTMLInputElement>(
      'input[name="portfolio-appearance"]',
    ),
  ];

  if (picker && families.length && modes.length) {
    const sync = () => {
      const preference = resolveThemeFamilyAndMode(
        document.documentElement.dataset.themeFamily,
        document.documentElement.dataset.themeMode,
      );
      const trigger = picker.querySelector("summary");
      const label = `Choose theme — ${preference.mode} appearance`;
      trigger?.setAttribute("aria-label", label);
      trigger?.setAttribute("title", label);
      families.forEach((input) => {
        input.checked = input.value === preference.family;
      });
      modes.forEach((input) => {
        input.checked = input.value === preference.mode;
      });
      const dark =
        preference.mode === "dark" ||
        (preference.mode === "system" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      picker
        .querySelectorAll<HTMLElement>(".theme-swatch")
        .forEach((swatch) => {
          swatch.dataset.theme = resolveThemeVariant(
            resolveThemeFamilyAndMode(swatch.dataset.family, "system").family,
            dark ? "dark" : "light",
            dark,
          );
        });
    };

    const apply = () => {
      const preference = resolveThemeFamilyAndMode(
        families.find((input) => input.checked)?.value,
        modes.find((input) => input.checked)?.value,
      );
      const variant = resolveThemeVariant(
        preference.family,
        preference.mode,
        window.matchMedia("(prefers-color-scheme: dark)").matches,
      );
      document.documentElement.dataset.themeFamily = preference.family;
      document.documentElement.dataset.themeMode = preference.mode;
      document.documentElement.dataset.theme = variant;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", getThemeColor(variant));
      try {
        localStorage.setItem(THEME_FAMILY_STORAGE_KEY, preference.family);
        localStorage.setItem(THEME_MODE_STORAGE_KEY, preference.mode);
      } catch {
        /* Keep the picker usable when storage is unavailable. */
      }
      sync();
    };

    sync();
    [...families, ...modes].forEach((input) =>
      input.addEventListener("change", apply),
    );
    const close = () => {
      picker.open = false;
      picker.querySelector("summary")?.focus();
    };
    picker.querySelector(".theme-close")?.addEventListener("click", close);
    picker.addEventListener("toggle", sync);
    window.addEventListener("pageshow", sync);
    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Node && !picker.contains(event.target))
        picker.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && picker.open) {
        picker.open = false;
        picker.querySelector("summary")?.focus();
      }
    });
  }
</script>
