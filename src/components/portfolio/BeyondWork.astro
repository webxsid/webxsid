---
import { Image } from "astro:assets";
import { portfolio } from "../../data/portfolio";

const { recognition } = portfolio.beyondWork;
---

<section
  id="beyond-work"
  class="section-grid"
  aria-labelledby="beyond-heading"
>
  <div class="section-intro">
    <h2 id="beyond-heading">Beyond work</h2>
  </div><div class="beyond-content">
    <p class="work-lead">{portfolio.beyondWork.introduction}</p><p
      class="body-copy"
    >
      {portfolio.beyondWork.description}
    </p><div class="beyond-links">
      {
        portfolio.beyondWork.links.map((link) => (
          <a href={link.href}>
            {link.label}
            {link.href.startsWith("http") && (
              <span aria-hidden="true">↗</span>
            )}
          </a>
        ))
      }
    </div><div class="beyond-recognition">
      <h3>Recognition</h3>
      <p class="beyond-recognition-title">{recognition.title}</p>
      <p class="beyond-recognition-meta">{recognition.meta}</p>
      <figure class="work-shot">
        <Image
          src={recognition.image.src}
          alt={recognition.image.alt}
          widths={[560, 840]}
          sizes="(min-width: 600px) 560px, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p class="body-copy">{recognition.description}</p>
      <a class="text-link" href={recognition.link.href} target="_blank" rel="noopener noreferrer"
        >{recognition.link.label} <span aria-hidden="true">↗</span></a
      >
    </div><a class="personal-site-link" href={portfolio.personalWebsite}
      >Explore my personal website <span aria-hidden="true">↗</span></a>
  </div>
</section>
