---
import { contactLinks, portfolio } from "../../data/portfolio";
const { includeEmail = true } = Astro.props;
const links = includeEmail
  ? contactLinks
  : contactLinks.filter((link) => !link.href.startsWith("mailto:"));
---

<div class="contact-links">
  {
    links.map((link) => (
      <a class="text-link" href={link.href}>
        {link.label} <span aria-hidden="true">↗</span>
      </a>
    ))
  }
  {
    portfolio.resume.href ? (
      <a class="text-link" href={portfolio.resume.href} download>
        {portfolio.resume.label} <span aria-hidden="true">↓</span>
      </a>
    ) : (
      <span class="resume-stub">{portfolio.resume.pendingLabel}</span>
    )
  }
</div>
