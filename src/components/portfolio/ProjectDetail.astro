---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioBreadcrumbs from "./PortfolioBreadcrumbs.astro";
import PortfolioPageHeading from "./PortfolioPageHeading.astro";
import PortfolioListing from "./PortfolioListing.astro";
import { portfolioCanonical } from "../../lib/portfolio";
type Props = { entry: CollectionEntry<"portfolioProjects"> };
const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const related = (
  await getCollection(
    "portfolioCaseStudies",
    ({ data: candidate }) =>
      candidate.visibility === "public" && !candidate.draft,
  )
).filter(
  (candidate) =>
    candidate.data.project?.id === entry.id ||
    data.relatedCaseStudies.some((ref) => ref.id === candidate.id),
);
---

<PortfolioLayout
  title={`${data.title} — Project — Siddharth Mittal`}
  description={data.description}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: data.title,
    description: data.description,
    url: portfolioCanonical(`/portfolio/projects/${entry.id}`),
    ...(data.links.repository ? { codeRepository: data.links.repository } : {}),
    author: { "@type": "Person", name: "Siddharth Mittal" },
  }}
>
  <main id="main" class="page-width portfolio-page">
    <PortfolioBreadcrumbs section="Projects" title={data.title} />
    <PortfolioPageHeading
      eyebrow={`Independent software / ${data.stage ?? data.status}`}
      title={data.title}
      description={data.description}
    />
    <div class="portfolio-detail-grid">
      <aside class="portfolio-metadata" aria-label="Project details">
        <dl>
          <div><dt>Role</dt><dd>{data.role}</dd></div><div>
            <dt>Status</dt><dd>{data.stage ?? data.status}</dd>
          </div>{
            data.startedAt && (
              <div>
                <>
                  <dt>Started</dt>
                  <dd>
                    <time datetime={data.startedAt.toISOString()}>
                      {data.startedAt.getUTCFullYear()}
                    </time>
                  </dd>
                </>
              </div>
            )
          }<div>
            <dt>Technologies</dt><dd>
              <ul class="stack">
                {data.technologies.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        </dl>{
          data.links.website && (
            <a class="text-link" href={data.links.website}>
              Visit website <span aria-hidden="true">↗</span>
            </a>
          )
        }{
          data.links.repository && (
            <a class="text-link" href={data.links.repository}>
              Source code <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </aside>
      <article class="portfolio-prose portfolio-narrative">
        <Content />{
          data.screenshots.map((screenshot) => (
            <figure>
              <img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
              {screenshot.caption && (
                <figcaption>{screenshot.caption}</figcaption>
              )}
            </figure>
          ))
        }
      </article>
    </div>
    {
      related.length > 0 && (
        <section class="portfolio-related" aria-labelledby="related-heading">
          <>
            <h2 id="related-heading">Engineering behind the project</h2>
            <PortfolioListing
              headingLevel="h3"
              entries={related.map((item) => ({
                title: item.data.title,
                description: item.data.summary,
                href: `/portfolio/work/${item.id}`,
                label: "Case study",
              }))}
            />
          </>
        </section>
      )
    }
  </main>
</PortfolioLayout>
