---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioBreadcrumbs from "./PortfolioBreadcrumbs.astro";
import PortfolioPageHeading from "./PortfolioPageHeading.astro";
import PortfolioListing from "./PortfolioListing.astro";
import { portfolioCanonical } from "../../lib/portfolio";
type Props = { entry: CollectionEntry<"portfolioCaseStudies"> };
const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const project = data.project ? await getEntry(data.project) : undefined;
const related = (
  await getCollection(
    "portfolioCaseStudies",
    ({ data: candidate }) =>
      candidate.visibility === "public" && !candidate.draft,
  )
).filter(
  (candidate) =>
    candidate.id !== entry.id &&
    data.relatedCaseStudies.some((ref) => ref.id === candidate.id),
);
const url = portfolioCanonical(`/portfolio/work/${entry.id}`);
---

<PortfolioLayout
  title={`${data.title} — Engineering case study — Siddharth Mittal`}
  description={data.summary}
  noindex={data.visibility === "unlisted" || data.draft}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.summary,
    url,
    author: { "@type": "Person", name: "Siddharth Mittal" },
  }}
>
  <main id="main" class="page-width portfolio-page">
    <PortfolioBreadcrumbs section="Work" title={data.title} />
    <PortfolioPageHeading
      eyebrow={data.category}
      title={data.title}
      description={data.summary}
    />
    {
      data.draft && (
        <p class="portfolio-draft-note">
          Case study scaffold · Details are being prepared. TODOs below identify
          what still needs review.
        </p>
      )
    }
    <div class="portfolio-detail-grid">
      <aside class="portfolio-metadata" aria-label="Case study details">
        <dl>
          <div><dt>Role</dt><dd>{data.role}</dd></div>{
            data.organization && (
              <div>
                <>
                  <dt>Organization</dt>
                  <dd>{data.organization}</dd>
                </>
              </div>
            )
          }{
            data.period && (
              <div>
                <>
                  <dt>Period</dt>
                  <dd>{data.period}</dd>
                </>
              </div>
            )
          }<div>
            <dt>Technologies</dt><dd>
              <ul class="stack">
                {data.technologies.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        </dl>{
          data.links.map((link) => (
            <a class="text-link" href={link.href}>
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </aside>
      <article class="portfolio-prose portfolio-narrative">
        {
          data.problem && (
            <section>
              <>
                <h2>Context and problem</h2>
                <p>{data.problem}</p>
              </>
            </section>
          )
        }
        {
          data.contribution && (
            <section>
              <>
                <h2>My contribution</h2>
                <p>{data.contribution}</p>
              </>
            </section>
          )
        }
        <Content />
        {
          data.outcome && (
            <section>
              <>
                <h2>Outcomes</h2>
                <p>{data.outcome}</p>
              </>
            </section>
          )
        }
      </article>
    </div>
    {
      (project || related.length > 0) && (
        <section class="portfolio-related" aria-labelledby="related-heading">
          <>
            <h2 id="related-heading">Related work</h2>
            <PortfolioListing
              entries={[
                ...(project
                  ? [
                      {
                        title: project.data.title,
                        description: project.data.description,
                        href: `/portfolio/projects/${project.id}`,
                        label: "Project overview",
                      },
                    ]
                  : []),
                ...related.map((item) => ({
                  title: item.data.title,
                  description: item.data.summary,
                  href: `/portfolio/work/${item.id}`,
                  label: "Case study",
                })),
              ]}
              headingLevel="h3"
            />
          </>
        </section>
      )
    }
  </main>
</PortfolioLayout>
