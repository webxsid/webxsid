---
type Props = { section: "Work" | "Projects"; title: string };
const { section, title } = Astro.props;
---

<nav class="portfolio-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/portfolio">Overview</a></li><li>
      <a href={`/portfolio/${section.toLowerCase()}`}>{section}</a>
    </li><li aria-current="page">{title}</li>
  </ol>
</nav>
