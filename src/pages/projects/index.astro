---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/shell/Container.astro";
import Section from "../../components/content/Section.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects · Webxsid"
  description="Projects and infrastructure notes."
  seo={{
    title: "Projects · Webxsid",
    description: "Selected projects and infrastructure notes from Webxsid.",
    canonical: "/projects",
  }}
  backHref="/"
>
  <Container>
    <div class="py-8 lg:py-14">
      <div class="max-w-4xl space-y-14">
        <Section title="Projects">
          <div
            class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted lg:text-[15px]"
          >
            <p>
              Most of the projects here begin as attempts to simplify some part
              of my own workflow, understand a system more deeply, or explore a
              particular way of building software.
            </p>

            <p>Some stay small. Some slowly turn into long-term systems.</p>
          </div>
        </Section>

        <div class="border-t border-border/70">
          {
            projects.map((project) => (
              <article class="group py-8">
                <div class="block space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="space-y-1">
                      <a href={`/projects/${project.id}`} class="title-link">
                        {project.data.title}
                      </a>

                      <p class="max-w-2xl text-sm leading-7 text-text-muted">
                        {project.data.summary}
                      </p>
                    </div>

                    <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.22em] text-text-muted">
                      <StatusBadge status={project.data.status} />
                    </span>
                  </div>

                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted">
                    <span>{project.data.stack.join(" · ")}</span>

                    {project.data.source && (
                      <>
                        <span class="text-border">/</span>

                        <a
                          href={project.data.source}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition hover:text-text inline-link"
                        >
                          Source
                        </a>
                      </>
                    )}

                    {project.data.live && (
                      <>
                        <span class="text-border">/</span>

                        <a
                          href={project.data.live}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition hover:text-text inline-link"
                        >
                          Site
                        </a>
                      </>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
