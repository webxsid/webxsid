---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import IndexGroup from "../../components/content/IndexGroup.astro";
import IndexHeader from "../../components/content/IndexHeader.astro";
import IndexRow from "../../components/content/IndexRow.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";
import {
  getProjectCompanyHref,
  getProjectExcerpt,
  getProjectHref,
  getProjectStackLabel,
  sortProjectsByStatus,
  type ProjectEntry,
} from "../../lib/projects";
import { getListOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

const projects = sortProjectsByStatus(await getCollection("projects"));
const groups = [
  {
    id: "personal",
    label: "Personal projects",
    entries: projects.filter((project) => !project.data.company),
  },
  {
    id: "professional",
    label: "Professional work",
    entries: projects.filter((project) => project.data.company),
  },
].filter((group) => group.entries.length > 0);

const intro =
  "Tools and apps I've built, with notes on how they work and why I made them.";

const seo = withAutoOgImage(
  {
    title: "Projects · Webxsid",
    description: intro,
    canonical: "/projects",
  },
  getListOgImagePath("projects"),
);

const getSummary = (project: ProjectEntry) =>
  project.data.detailsPage === false
    ? getProjectExcerpt(project.body ?? "") || project.data.summary
    : project.data.summary;

const getDisplayHost = (url: string) =>
  new URL(url).hostname.replace(/^www\./, "");

const getExternalLinks = (project: ProjectEntry) =>
  [
    project.data.source && { label: "source", href: project.data.source },
    project.data.website && {
      label: getDisplayHost(project.data.website),
      href: project.data.website,
    },
    project.data.demo && { label: "demo", href: project.data.demo },
  ].filter((link): link is { label: string; href: string } => Boolean(link));
---

<BaseLayout
  title="Projects · Webxsid"
  description={intro}
  seo={seo}
  backHref="/"
>
  <ContentPageFrame>
    <div class="space-y-10">
      <IndexHeader title="Projects" intro={intro} />

      <div class="index-groups">
        {
          groups.map((group) => (
            <IndexGroup label={group.label} id={`projects-${group.id}`}>
              {group.entries.map((project) => {
                const stackLabel = getProjectStackLabel(project);
                const company = project.data.company;
                const companyHref = getProjectCompanyHref(project);
                const links = getExternalLinks(project);

                return (
                  <IndexRow
                    href={getProjectHref(project)}
                    title={project.data.title}
                    muted={project.data.status === "archived"}
                  >
                    <StatusBadge
                      slot="badge"
                      status={project.data.status}
                      class="shrink-0"
                    />
                    {getSummary(project)}
                    <Fragment slot="meta">
                      {company && companyHref && (
                        <span>
                          at{" "}
                          <a class="index-row-meta-link" href={companyHref}>{company.name}</a>
                        </span>
                      )}
                      {stackLabel && <span>{stackLabel}</span>}
                      {links.map((link) => (
                        <a
                          class="index-row-meta-link"
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >{`${link.label} ↗`}</a>
                      ))}
                    </Fragment>
                  </IndexRow>
                );
              })}
            </IndexGroup>
          ))
        }
      </div>
    </div>
  </ContentPageFrame>
</BaseLayout>
