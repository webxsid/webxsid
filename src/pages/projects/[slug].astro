---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ProjectMetadataFooter from "../../components/content/ProjectMetadataFooter.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";
import {
  getEmptyContentLinkProfile,
  getContentLinkProfiles,
} from "../../lib/content-links";
import {
  getProjectCompanyLabel,
  getProjectCompanyHref,
  getProjectStackLabel,
  isProjectDetailPage,
  getProjectTagsLabel,
} from "../../lib/projects";
import { getProjectOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects
    .filter((entry) => isProjectDetailPage(entry))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seo = withAutoOgImage(entry.data.seo, getProjectOgImagePath(entry.id));
const projectItems = (await getCollection("projects"))
  .filter((item) => isProjectDetailPage(item))
  .map((item) => ({
    id: item.id,
    title: item.data.title,
    status: item.data.status,
    updatedAt: item.data.updatedAt,
    order: item.data.order,
    yearStarted: item.data.yearStarted,
    yearEnded: item.data.yearEnded,
    detailsPage: item.data.detailsPage,
  }));
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/projects/${entry.id}`) ?? getEmptyContentLinkProfile();
const companyLabel = getProjectCompanyLabel(entry);
const stackLabel = getProjectStackLabel(entry);
const companyHref = getProjectCompanyHref(entry);
const tagLabel = getProjectTagsLabel(entry);
const declaredProjectUrls = [
  entry.data.source,
  entry.data.website,
  entry.data.demo,
].filter((url): url is string => Boolean(url));
---

<ProjectLayout
  title={`${entry.data.title} · Projects · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  articlePublishedTime={entry.data.updatedAt.toISOString()}
  articleModifiedTime={entry.data.updatedAt.toISOString()}
  projectItems={projectItems}
  activeId={entry.id}
>
  <div class="max-w-4xl space-y-12 lg:space-y-14" data-content-preview-scope>
    <header class="motion-page max-w-3xl space-y-6">
      <div class="space-y-3">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
          <h1 class="ui-title font-semibold tracking-tight text-text">
            {entry.data.title}
          </h1>

          <StatusBadge status={entry.data.status} />
        </div>

        <p class="ui-body max-w-3xl text-text-muted">
          {entry.data.summary}
        </p>
      </div>

      <div class="ui-body space-y-1 text-text-muted">
        {
          companyLabel && (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <p class="ui-tag leading-6">Built at:</p>
              {companyHref ? (
                <a href={companyHref} class="meta-link">
                  {companyLabel}
                </a>
              ) : (
                <p class="ui-tag">{companyLabel}</p>
              )}
            </div>
          )
        }

        {
          stackLabel && (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 ">
              <p class="ui-tag leading-6">
                <span class="font-bold"> Built With:</span> {stackLabel}
              </p>
            </div>
          )
        }

        {
          tagLabel && (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <p class="ui-tag leading-6">
                <span class="font-bold">Tags:</span> {tagLabel}
              </p>
            </div>
          )
        }
      </div>
    </header>

    <ContentDocument class="space-y-4">
      <Content />
    </ContentDocument>

    <ProjectMetadataFooter
      profile={linkProfile}
      declaredUrls={declaredProjectUrls}
    />
    <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
  </div>
</ProjectLayout>
