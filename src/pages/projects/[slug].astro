---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ProjectMetadataFooter from "../../components/content/ProjectMetadataFooter.astro";
import ContentMetadata from "../../components/content/ContentMetadata.astro";
import ContentTags from "../../components/content/ContentTags.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";
import {
  getEmptyContentLinkProfile,
  getContentLinkProfiles,
} from "../../lib/content-links";
import {
  getProjectCompanyLabel,
  getProjectCompanyHref,
  getProjectStackLabel,
  isProjectDetailPage,
} from "../../lib/projects";
import { getProjectOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";
import { formatDate } from "../../lib/dates";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects
    .filter((entry) => isProjectDetailPage(entry))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seo = withAutoOgImage(entry.data.seo, getProjectOgImagePath(entry.id));
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/projects/${entry.id}`) ?? getEmptyContentLinkProfile();
const companyLabel = getProjectCompanyLabel(entry);
const stackLabel = getProjectStackLabel(entry);
const companyHref = getProjectCompanyHref(entry);
const declaredProjectUrls = [
  entry.data.source,
  entry.data.website,
  entry.data.demo,
].filter((url): url is string => Boolean(url));
---

<BaseLayout
  title={`${entry.data.title} · Projects · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articlePublishedTime={entry.data.updatedAt.toISOString()}
  articleModifiedTime={entry.data.updatedAt.toISOString()}
  articleSection="Projects"
  backHref="/projects"
  backLabel="Back to projects"
>
  <ContentPageFrame>
    <div class="max-w-4xl space-y-12 lg:space-y-14" data-content-preview-scope>
      <header class="motion-page max-w-3xl space-y-7">
        <div class="space-y-4">
          <div
            class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between"
          >
            <h1 class="ui-title font-display font-semibold tracking-tight text-text">
              {entry.data.title}
            </h1>

            <StatusBadge
              status={entry.data.status}
              class="rounded-full px-2.5 py-1 text-[0.7rem] tracking-[0.14em]"
            />
          </div>

          <p class="ui-lead max-w-xl text-text">
            {entry.data.summary}
          </p>
        </div>

        {
          <ContentMetadata
            items={[
              ...(companyLabel
                ? [{ label: "Company", value: companyLabel, href: companyHref ?? undefined }]
                : []),
              ...(stackLabel ? [{ label: "Built with", value: stackLabel }] : []),
              { label: "Updated", value: formatDate(entry.data.updatedAt) },
            ]}
          />
        }

        {
          declaredProjectUrls.length > 0 && (
            <nav
              aria-label="Project links"
              class="flex flex-wrap gap-x-6 gap-y-3 border-t border-border/45 pt-5"
            >
              {entry.data.source && (
                <a
                  href={entry.data.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-link"
                >
                  Source code
                </a>
              )}
              {entry.data.website && (
                <a
                  href={entry.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-link"
                >
                  Website
                </a>
              )}
              {entry.data.demo && (
                <a
                  href={entry.data.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-link"
                >
                  Demo
                </a>
              )}
            </nav>
          )
        }

        <ContentTags tags={entry.data.tags} />
      </header>

      <ContentDocument class="space-y-4">
        <Content />
      </ContentDocument>

      <ProjectMetadataFooter
        profile={linkProfile}
        declaredUrls={declaredProjectUrls}
      />
      <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
    </div>
  </ContentPageFrame>
</BaseLayout>
