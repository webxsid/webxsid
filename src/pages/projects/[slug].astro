---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";
import ContentLinkFooter from "../../components/content/ContentLinkFooter.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";
import { getContentLinkProfiles, getEmptyContentLinkProfile } from "../../lib/content-links";
import { getProjectOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seo = withAutoOgImage(entry.data.seo, getProjectOgImagePath(entry.id));
const projectItems = (await getCollection("projects")).map((item) => ({
  id: item.id,
  title: item.data.title,
  status: item.data.status,
  updatedAt: item.data.updatedAt,
  order: item.data.order,
}));
const linkProfiles = await getContentLinkProfiles();
const linkProfile = linkProfiles.get(`/projects/${entry.id}`) ?? getEmptyContentLinkProfile();

const updatedAt = entry.data.updatedAt
  ? new Date(entry.data.updatedAt).toLocaleDateString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
---

<ProjectLayout
  title={`${entry.data.title} · Projects · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  projectItems={projectItems}
  activeId={entry.id}
>
  <div class="max-w-4xl space-y-12 lg:space-y-16" data-content-preview-scope>
    <ContentHeader eyebrow="Project" title={entry.data.title} summary={entry.data.summary}>
      <span slot="meta" class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <StatusBadge status={entry.data.status} />

        <span class="text-border">/</span>

        <span>{entry.data.stack.join(" · ")}</span>

        {
          updatedAt && (
            <>
              <span class="text-border">/</span>
              <span>{updatedAt}</span>
            </>
          )
        }

        {
          entry.data.source && (
            <>
              <span class="text-border">/</span>
              <a
                href={entry.data.source}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-text"
              >
                Source
              </a>
            </>
          )
        }

        {
          entry.data.live && (
            <>
              <span class="text-border">/</span>
              <a
                href={entry.data.live}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-text"
              >
                Site
              </a>
            </>
          )
        }
      </span>
    </ContentHeader>

    <ContentDocument class="space-y-4">
      <Content />
    </ContentDocument>

    <ContentLinkFooter profile={linkProfile} />
    <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
  </div>
</ProjectLayout>
