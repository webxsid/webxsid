---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ContentLinkFooter from "../../components/content/ContentLinkFooter.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import IndexHeader from "../../components/content/IndexHeader.astro";
import StatusBadge from "../../components/content/StatusBadge.astro";
import {
  getEmptyContentLinkProfile,
  getContentLinkProfiles,
} from "../../lib/content-links";
import {
  getProjectCompanyHref,
  getProjectHref,
  getProjectLinks,
  getProjectStackLabel,
  isProjectDetailPage,
  sortProjectsByStatus,
} from "../../lib/projects";
import { getProjectOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";
import { formatDate } from "../../lib/dates";

export async function getStaticPaths() {
  // Same order as the /projects index, so the pager walks the list.
  const projects = sortProjectsByStatus(
    (await getCollection("projects")).filter(isProjectDetailPage),
  );

  return projects.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const seo = withAutoOgImage(entry.data.seo, getProjectOgImagePath(entry.id));
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/projects/${entry.id}`) ?? getEmptyContentLinkProfile();
const stackLabel = getProjectStackLabel(entry);
const company = entry.data.company;
const companyHref = getProjectCompanyHref(entry);
const links = getProjectLinks(entry);
const tags = [...new Set(entry.data.tags.map((tag) => tag.trim()).filter(Boolean))];
---

<BaseLayout
  title={`${entry.data.title} · Projects · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articlePublishedTime={entry.data.updatedAt.toISOString()}
  articleModifiedTime={entry.data.updatedAt.toISOString()}
  articleSection="Projects"
  backHref="/projects"
  backLabel="Back to projects"
>
  <ContentPageFrame>
    <div class="max-w-3xl space-y-12" data-content-preview-scope>
      <IndexHeader
        title={entry.data.title}
        intro={entry.data.summary}
        prompt={`$ projects --show ${entry.id}`}
      >
        <Fragment slot="meta">
          <p class="index-row-meta ui-meta font-mono">
            <StatusBadge status={entry.data.status} />
            {stackLabel && <span>{stackLabel}</span>}
            <span>updated {formatDate(entry.data.updatedAt)}</span>
          </p>
          {
            company && companyHref && (
              <p class="index-row-meta ui-meta font-mono">
                <span>
                  professional work at{" "}
                  <a class="index-row-meta-link" href={companyHref}>{`${company.name} →`}</a>
                </span>
              </p>
            )
          }
          {
            links.length > 0 && (
              <nav class="index-row-meta ui-meta font-mono" aria-label="Project links">
                {links.map((link) => (
                  <a
                    class="index-row-meta-link"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >{`${link.label} ↗`}</a>
                ))}
              </nav>
            )
          }
          {
            tags.length > 0 && (
              <ul class="index-row-meta ui-meta font-mono" aria-label="Tags">
                {tags.map((tag) => <li>{tag.toLowerCase()}</li>)}
              </ul>
            )
          }
        </Fragment>
      </IndexHeader>

      <ContentDocument class="space-y-4">
        <Content />
      </ContentDocument>

      <ContentLinkFooter
        profile={linkProfile}
        declaredUrls={links.map((link) => link.href)}
      />

      <nav class="content-pager ui-meta font-mono" aria-label="More projects">
        {
          previous ? (
            <a href={getProjectHref(previous)} rel="prev">
              ← {previous.data.title}
            </a>
          ) : (
            <span />
          )
        }
        <a href="/projects">all projects</a>
        {
          next ? (
            <a href={getProjectHref(next)} rel="next">
              {next.data.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
    </div>
  </ContentPageFrame>
</BaseLayout>
