---
import { getCollection } from "astro:content";
import PortfolioLayout from "../../../layouts/PortfolioLayout.astro";
import PortfolioPageHeading from "../../../components/portfolio/PortfolioPageHeading.astro";
import PortfolioListing from "../../../components/portfolio/PortfolioListing.astro";
const entries = (await getCollection("portfolioProjects")).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order,
);
---

<PortfolioLayout
  title="Independent projects — Siddharth Mittal"
  description="Crona, Pebbles, and independently built software: technical overviews, current status, and related engineering work."
>
  <main id="main" class="page-width portfolio-page">
    <PortfolioPageHeading
      eyebrow="Projects / Independent software"
      title="Software with a point of view."
      description="Tools built around ownership, clear interfaces, and the way people actually work."
    /><PortfolioListing
      entries={entries.map((entry) => ({
        title: entry.data.title,
        description: entry.data.description,
        href: `/portfolio/projects/${entry.id}`,
        label: entry.data.stage ?? entry.data.status,
        technologies: entry.data.technologies,
        featured: entry.data.featured,
      }))}
    />
  </main>
</PortfolioLayout>
