---
import { getCollection, getEntry, render } from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioListing from "../../components/portfolio/PortfolioListing.astro";

const profile = await getEntry("portfolioProfile", "sid");
if (!profile)
  throw new Error(
    "Add a portfolio profile at src/content/portfolio/profile/sid.md",
  );
const { Content: About } = await render(profile);
const person = profile.data;
const projects = (
  await getCollection("portfolioProjects", ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
const cases = (
  await getCollection(
    "portfolioCaseStudies",
    ({ data }) => data.featured && data.visibility === "public" && !data.draft,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<PortfolioLayout
  title={`${person.name} — ${person.role}`}
  description={person.seoDescription}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: person.name,
    jobTitle: person.role,
    email: person.email,
    sameAs: [person.github],
  }}
>
  <main id="main">
    <section class="hero" aria-labelledby="portfolio-name">
      <div class="page-width">
        <div class="hero-topline">
          <p class="eyebrow">{person.role}</p><p class="availability">
            <span aria-hidden="true"></span>{person.availability}
          </p>
        </div>
        <h1 id="portfolio-name">
          {
            person.name.split(" ").map((part, index) => (
              <>
                <span>{part}</span>
                {index < person.name.split(" ").length - 1 && " "}
              </>
            ))
          }
        </h1>
        <div class="hero-bottom">
          <h2>{person.headline}</h2>
          <div class="hero-description">
            <p>{person.summary}</p>
            <div class="hero-actions">
              <a class="contact-button" href="/portfolio/work"
                >View selected work <span aria-hidden="true">↓</span></a
              >
              <a class="text-link" href="/portfolio/contact"
                >Let’s talk <span aria-hidden="true">↗</span></a
              >
              {
                person.resume && (
                  <a class="text-link" href={person.resume.href}>
                    {person.resume.label} <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      id="work"
      class="work-section page-width"
      aria-labelledby="work-heading"
    >
      <div class="section-heading">
        <p class="eyebrow">01 / Selected work</p><h2 id="work-heading">
          Built with intent.<br /><span class="muted"
            >Maintained with care.</span
          >
        </h2>
      </div>
      <PortfolioListing
        headingLevel="h3"
        entries={projects.map((entry) => ({
          title: entry.data.title,
          description: entry.data.description,
          href: `/portfolio/projects/${entry.id}`,
          label: entry.data.stage ?? entry.data.status,
          technologies: entry.data.technologies,
        }))}
      />
      <a class="text-link" href="/portfolio/projects"
        >All projects <span aria-hidden="true">→</span></a
      >
      {
        cases.length > 0 && (
          <div class="portfolio-home-cases">
            <>
              <h3>Engineering case studies</h3>
              <PortfolioListing
                headingLevel="h3"
                entries={cases.map((entry) => ({
                  title: entry.data.title,
                  description: entry.data.summary,
                  href: `/portfolio/work/${entry.id}`,
                  label: entry.data.category,
                }))}
              />
              <a class="text-link" href="/portfolio/work">
                All case studies <span aria-hidden="true">→</span>
              </a>
            </>
          </div>
        )
      }
    </section>
    <section class="experience-section">
      <div class="page-width section-grid">
        <div class="section-intro">
          <p class="eyebrow">02 / Experience</p><h2>
            Close to the<br />real problems.
          </h2>
        </div><div>
          <p class="muted">
            From customer-facing features to the infrastructure that keeps them
            running.
          </p><a class="text-link" href="/portfolio/experience"
            >View professional timeline <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>
    <section
      class="about-section page-width section-grid"
      aria-labelledby="about-heading"
    >
      <div class="section-intro">
        <p class="eyebrow">03 / Approach</p><h2 id="about-heading">
          A little about<br />how I work.
        </h2>
      </div>
      <div class="about-content">
        <div class="portfolio-prose"><About /></div><ul
          class="focus-list"
          aria-label="Engineering focus"
        >
          {person.focus.map((focus) => <li>{focus}</li>)}
        </ul>
      </div>
    </section>
    <section
      id="contact"
      class="contact-section"
      aria-labelledby="contact-heading"
    >
      <div class="page-width">
        <p class="eyebrow">Let’s build something useful</p><h2
          id="contact-heading"
        >
          Good work starts<br />with a conversation.
        </h2><a class="contact-email" href={`mailto:${person.email}`}
          >{person.email}<span aria-hidden="true">↗</span></a
        ><p>
          Interested in backend systems, platform engineering, and tools that
          make other people’s work easier.
        </p>
      </div>
    </section>
  </main>
</PortfolioLayout>
