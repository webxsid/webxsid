---
import { getEntry } from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioPageHeading from "../../components/portfolio/PortfolioPageHeading.astro";
const profile = await getEntry("portfolioProfile", "sid");
if (!profile) throw new Error("Portfolio profile missing");
const person = profile.data;
---

<PortfolioLayout
  title="Contact — Siddharth Mittal"
  description="Get in touch with Siddharth Mittal about backend engineering, platform roles, and developer tools."
  ><main id="main" class="page-width portfolio-page">
    <PortfolioPageHeading
      eyebrow="Contact / Let’s talk"
      title="Good work starts with a conversation."
      description={person.availability}
    /><section class="portfolio-contact-links" aria-label="Contact information">
      <a class="contact-email" href={`mailto:${person.email}`}
        >{person.email}<span aria-hidden="true">↗</span></a
      ><p class="muted">
        Interested in backend systems, platform engineering, and tools that make
        other people’s work easier.
      </p><a class="text-link" href={person.github}
        >GitHub <span aria-hidden="true">↗</span></a
      >{
        person.resume && (
          <a class="text-link" href={person.resume.href}>
            {person.resume.label} <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </section>
  </main></PortfolioLayout
>
