---
import { getCollection } from "astro:content";
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioPageHeading from "../../components/portfolio/PortfolioPageHeading.astro";
import ExperienceTimeline from "../../components/portfolio/ExperienceTimeline.astro";
const entries = await getCollection("portfolioExperience");
---

<PortfolioLayout
  title="Experience — Siddharth Mittal"
  description="Backend and platform engineering experience at Taptic and Appyhigh, with responsibilities and contributions."
  ><main id="main" class="page-width portfolio-page">
    <PortfolioPageHeading
      eyebrow="Experience / Professional timeline"
      title="Close to the real problems."
      description="From customer-facing features to the infrastructure that keeps them running."
    /><div class="portfolio-timeline">
      <ExperienceTimeline entries={entries} />
    </div>
  </main></PortfolioLayout
>
