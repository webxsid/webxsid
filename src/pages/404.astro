---
import "../styles/global.css";
import SeoHead from "../components/shell/SeoHead.astro";
import ShellLoadBoot from "../components/shell/ShellLoadBoot.astro";
import ShellLoadUX from "../components/shell/ShellLoadUX.astro";
import ThemeBootstrap from "../components/shell/ThemeBootstrap.astro";
import { getCollection } from "astro:content";
import { getProjectHref, isProjectDetailPage } from "../lib/projects";
import { filterPublicWritingEntries, getWritingPath } from "../lib/writing";

// Every real route, so the page can suggest the nearest one to a typo.
const [projects, writing, work] = await Promise.all([
  getCollection("projects"),
  getCollection("writing"),
  getCollection("work"),
]);
const routes = [
  "/",
  "/projects",
  "/writing",
  "/notes",
  "/now",
  "/references",
  "/colophon",
  "/portfolio",
  "/resume.pdf",
  ...projects.filter(isProjectDetailPage).map(getProjectHref),
  ...filterPublicWritingEntries(writing).map(getWritingPath),
  ...work.map((entry) => `/work/${entry.id}`),
];

const seo = {
  title: "404 · Webxsid",
  description: "The page wandered off somewhere else.",
  canonical: "/404",
  noindex: true,
};
---

<html lang="en" data-theme="graphite">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#121214" />
    <ShellLoadBoot />
    <SeoHead
      title="404 · Webxsid"
      description="The page wandered off somewhere else."
      pathname={Astro.url.pathname}
      seo={seo}
    />
    <ThemeBootstrap />
    <style>
      :root {
        --error-grid-size: 76px;
      }

      body {
        min-height: 100dvh;
        overflow: hidden;
        background:
          radial-gradient(
            circle at 50% 35%,
            rgba(255, 255, 255, 0.05),
            transparent 45%
          ),
          rgb(var(--surface-page));
      }

      .error-page {
        position: relative;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
      }

      .error-grid {
        pointer-events: none;
        position: absolute;
        inset: -16%;
        background-image:
          linear-gradient(rgba(var(--border-default) / 0.24) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(var(--border-default) / 0.24) 1px,
            transparent 1px
          );
        background-size: calc(var(--error-grid-size) * 1.15)
          calc(var(--error-grid-size) * 1.15);
        background-position: 0 0;
        opacity: 0.45;
        mask-image: radial-gradient(
          circle at 50% 45%,
          black 34%,
          transparent 78%
        );
        animation: error-grid-drift 28s linear infinite;
      }

      .error-grid::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(var(--accent-primary) / 0.075) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(var(--accent-primary) / 0.075) 1px,
            transparent 1px
          );
        background-size: calc(var(--error-grid-size) * 2)
          calc(var(--error-grid-size) * 2);
        opacity: 0.7;
        animation: error-grid-shift 22s linear infinite;
      }

      .error-shell {
        position: relative;
        z-index: 1;
        width: min(45rem, 100%);
        text-align: center;
      }

      .error-kicker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 4rem;
        padding: 0.45rem 0.8rem;
        border: 1px solid rgb(var(--border-default) / 0.7);
        border-radius: 999px;
        background: rgb(var(--surface-elevated) / 0.65);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: rgb(var(--text-muted));
      }

      html[data-theme="retro"] .error-kicker,
      html[data-theme="retro-dark"] .error-kicker {
        border-radius: 0.25rem;
        box-shadow:
          0 0 0 2px rgba(var(--border-default) / 0.18),
          0 3px 0 rgba(var(--border-default) / 0.55);
      }

      .error-title {
        margin-top: 1.5rem;
        font-family: var(--font-serif, Georgia, serif);
        font-size: clamp(4rem, 15vw, 6rem);
        line-height: 0.92;
        letter-spacing: -0.08em;
        color: rgb(var(--text-primary));
      }

      html[data-theme="retro"] .error-title,
      html[data-theme="retro-dark"] .error-title {
        font-family: var(--font-display-stack);
        font-size: clamp(2.2rem, 7vw, 3.6rem);
        line-height: 1.15;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .error-copy {
        margin: 1.1rem auto 0;
        max-width: 22rem;
        font-size: clamp(0.98rem, 1.8vw, 1.05rem);
        line-height: 1.7;
        color: rgb(var(--text-muted));
      }

      html[data-theme="retro"] .error-copy,
      html[data-theme="retro-dark"] .error-copy {
        max-width: 26rem;
        font-family: var(--font-sans-stack);
        font-size: clamp(1.2rem, 2vw, 1.45rem);
        line-height: 1.45;
      }

      .error-term {
        display: grid;
        gap: 0.3rem;
        margin: 1.4rem auto 0;
        width: fit-content;
        max-width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid rgb(var(--border-default) / 0.7);
        border-radius: var(--radius-code);
        background: rgb(var(--surface-elevated) / 0.65);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        text-align: left;
        color: rgb(var(--text-muted));
        overflow-wrap: anywhere;
      }

      .error-term > span:first-child {
        color: rgb(var(--text-primary));
      }

      .error-suggest-link {
        font-family: var(--font-mono);
        color: rgb(var(--text-primary));
        text-decoration: underline;
        text-decoration-color: rgb(var(--accent-primary) / 0.6);
        text-underline-offset: 3px;
      }

      .error-past {
        margin-top: 2.5rem;
        padding: 0.25rem;
        border: 0;
        background: none;
        font-family: var(--font-mono);
        font-size: 11px;
        color: rgb(var(--text-muted) / 0.35);
        cursor: pointer;
        transition: color 200ms ease;
      }

      .error-past:hover,
      .error-past:focus-visible {
        color: rgb(var(--text-primary));
      }

      .error-actions {
        margin-top: 2rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 1.5rem;
      }

      .error-home {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgb(var(--text-primary));
        text-decoration: none;
        border-bottom: 1px solid rgb(var(--accent-primary) / 0.45);
        padding-bottom: 0.2rem;
      }

      .error-home:hover {
        border-bottom-color: rgb(var(--accent-primary));
      }

      html[data-theme="retro"] .error-home,
      html[data-theme="retro-dark"] .error-home {
        border-bottom-width: 2px;
      }

      @keyframes error-grid-drift {
        from {
          transform: translate3d(0, 0, 0) scale(1.03);
        }

        50% {
          transform: translate3d(-1.25%, 0.75%, 0) scale(1.04);
        }

        to {
          transform: translate3d(0, 0, 0) scale(1.03);
        }
      }

      @keyframes error-grid-shift {
        from {
          transform: translate3d(0, 0, 0);
        }

        50% {
          transform: translate3d(0.75%, -0.5%, 0);
        }

        to {
          transform: translate3d(0, 0, 0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .error-grid,
        .error-grid::after {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <ShellLoadUX />
    <main class="error-page">
      <div class="error-grid" aria-hidden="true"></div>

      <section class="error-shell" aria-labelledby="error-title">
        <div class="error-kicker">404</div>
        <h1 id="error-title" class="error-title">Nothing to see here.</h1>
        <p class="error-term">
          <span>$ cd <span data-missing-path>this-page</span></span>
          <span>cd: no such file or directory</span>
        </p>
        <p class="error-copy" data-suggest hidden>
          Did you mean <a class="error-suggest-link" href="/"></a>?
        </p>
        <div class="error-actions">
          <a href="/" class="error-home">Return home</a>
          <a href="/sitemap.xml" class="error-home">Sitemap</a>
          <a href="/llms.txt" class="error-home">llms.txt</a>
        </div>
        <button type="button" class="error-past" data-error-past>
          or take the long way round, through 1999
        </button>
      </section>
    </main>
    <script is:inline type="application/json" id="error-routes" set:html={JSON.stringify(routes)} />
    <script>
      import {
        applyThemePreference,
        resolveThemeFamilyAndMode,
        THEME_BEFORE_UNLOCK_STORAGE_KEY,
        THEME_UNLOCKED_STORAGE_KEY,
      } from "../components/react/header/header-utils";

      const path = decodeURI(location.pathname).replace(/\/+$/, "") || "/";
      const missing = document.querySelector("[data-missing-path]");
      if (missing) missing.textContent = path;

      // Edit distance, to suggest the nearest real route to a typo.
      const distance = (a: string, b: string) => {
        const row = Array.from({ length: b.length + 1 }, (_, i) => i);
        for (let i = 1; i <= a.length; i++) {
          let previous = row[0];
          row[0] = i;
          for (let j = 1; j <= b.length; j++) {
            const current = row[j];
            row[j] = Math.min(row[j] + 1, row[j - 1] + 1, previous + (a[i - 1] === b[j - 1] ? 0 : 1));
            previous = current;
          }
        }
        return row[b.length];
      };

      const routes: string[] = JSON.parse(
        document.getElementById("error-routes")?.textContent ?? "[]",
      );
      const needle = path.toLowerCase();
      const best = routes
        .map((route) => ({ route, score: distance(needle, route) }))
        .sort((a, b) => a.score - b.score)[0];
      if (best && best.score > 0 && best.score <= Math.max(2, Math.floor(needle.length / 3))) {
        const link = document.querySelector<HTMLAnchorElement>(".error-suggest-link");
        if (link) {
          link.href = best.route;
          link.textContent = best.route;
          link.closest<HTMLElement>("[data-suggest]")?.removeAttribute("hidden");
        }
      }

      // The quiet way into the 1999 theme, as the footer year does it.
      document.querySelector("[data-error-past]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current = resolveThemeFamilyAndMode(root.dataset.themeFamily, root.dataset.themeMode);
        try {
          if (current.family !== "web99") {
            localStorage.setItem(THEME_BEFORE_UNLOCK_STORAGE_KEY, current.family);
          }
          localStorage.setItem(THEME_UNLOCKED_STORAGE_KEY, "1");
        } catch {
          /* The theme still applies for this visit. */
        }
        applyThemePreference("web99", current.mode);
        location.href = "/";
      });
    </script>
  </body>
</html>
