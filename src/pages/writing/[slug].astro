---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import WritingArticle from "../../components/content/WritingArticle.astro";
import { getWritingPath, filterPublicWritingEntries } from "../../lib/writing";
import {
  getContentLinkProfiles,
  getEmptyContentLinkProfile,
} from "../../lib/content-links";
import { getWritingOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

export async function getStaticPaths() {
  const writing = await getCollection("writing");

  return filterPublicWritingEntries(writing).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allWriting = filterPublicWritingEntries(await getCollection("writing"));
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(getWritingPath(entry)) ?? getEmptyContentLinkProfile();
const currentPath = getWritingPath(entry);
const outgoingWritingPaths = new Set(
  (linkProfile.previewLinks ?? [])
    .filter((link) => link.isInternal && link.href.startsWith("/writing/"))
    .map((link) => link.href),
);
const incomingWritingPaths = new Set(
  (linkProfile.backlinks ?? [])
    .filter((link) => link.href.startsWith("/writing/"))
    .map((link) => link.href),
);
const currentTags = new Set(entry.data.tags.map((tag) => tag.toLocaleLowerCase()));
const relatedArticles = allWriting
  .filter((candidate) => candidate.id !== entry.id)
  .map((candidate) => {
    const href = getWritingPath(candidate);
    const linked =
      outgoingWritingPaths.has(href) ||
      incomingWritingPaths.has(href) ||
      (linkProfiles.get(href)?.backlinks ?? []).some((link) => link.href === currentPath);
    const sharedTags = candidate.data.tags.filter((tag) =>
      currentTags.has(tag.toLocaleLowerCase()),
    );

    return { candidate, href, linked, sharedTags };
  })
  .filter(({ linked, sharedTags }) => linked || sharedTags.length > 0)
  .sort(
    (a, b) =>
      Number(b.linked) - Number(a.linked) ||
      b.sharedTags.length - a.sharedTags.length ||
      b.candidate.data.publishedAt.getTime() - a.candidate.data.publishedAt.getTime(),
  )
  .map(({ candidate, href, linked, sharedTags }) => ({
    href,
    title: candidate.data.title,
    publishedAt: candidate.data.publishedAt,
    linked,
    sharedTags,
  }));
const seo = withAutoOgImage(entry.data.seo, getWritingOgImagePath(entry.id));
---

<BaseLayout
  title={`${entry.data.title} · Writing · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  keywords={entry.data.tags}
  articleTags={entry.data.tags}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articlePublishedTime={entry.data.publishedAt.toISOString()}
  articleSection="Writing"
  backHref="/writing"
  backLabel="Back to writing"
>
  <ContentPageFrame>
    <WritingArticle
      title={entry.data.title}
      summary={entry.data.summary}
      publishedAt={entry.data.publishedAt}
      tags={entry.data.tags}
      linkProfile={linkProfile}
      showConnectedWriting={false}
      relatedArticles={relatedArticles}
    >
      <Content />
    </WritingArticle>
  </ContentPageFrame>
</BaseLayout>
