---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/shell/Container.astro";
import Section from "../../../components/content/Section.astro";
import ArticleList from "../../../components/content/ArticleList.astro";
import { filterWritingEntries, sortWritingEntries } from "../../../lib/writing";

const writing = await getCollection("writing");
const blogs = sortWritingEntries(filterWritingEntries(writing, "blog"));
---

<BaseLayout
  title="Blogs · Webxsid"
  description="Long-form writing and essays."
  seo={{
    title: "Blogs · Webxsid",
    description: "Long-form writing and essays from Webxsid.",
    canonical: "/writing/blogs",
  }}
  backHref="/writing"
>
  <Container>
    <div class="py-8 lg:py-14">
      <div class="max-w-4xl space-y-14">
        <Section eyebrow="writing" title="Blogs">
          <div
            class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted lg:text-[15px]"
          >
            <p>
              Longer posts with room for context, structure, and deeper
              explanation.
            </p>
          </div>
        </Section>

        <ArticleList
          entries={blogs}
          basePath="/writing/blogs"
          kindLabel="Blog"
        />
      </div>
    </div>
  </Container>
</BaseLayout>
