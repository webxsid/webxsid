---
import { getCollection, render } from "astro:content";
import WritingLayout from "../../../layouts/WritingLayout.astro";
import WritingArticle from "../../../components/content/WritingArticle.astro";
import { filterWritingEntries, sortWritingEntries } from "../../../lib/writing";
import { getContentLinkProfiles, getEmptyContentLinkProfile } from "../../../lib/content-links";
import { getWritingPath } from "../../../lib/writing";
import { getWritingOgImagePath } from "../../../lib/og-image";
import { withAutoOgImage } from "../../../lib/seo";

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  const blogs = filterWritingEntries(writing, "blog");

  return blogs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const writing = await getCollection("writing");
const linkProfiles = await getContentLinkProfiles();
const linkProfile = linkProfiles.get(getWritingPath(entry)) ?? getEmptyContentLinkProfile();
const seo = withAutoOgImage(entry.data.seo, getWritingOgImagePath("blog", entry.id));
const blogItems = sortWritingEntries(filterWritingEntries(writing, "blog")).map(
  (item) => ({
    id: item.id,
    title: item.data.title,
    publishedAt: item.data.publishedAt,
    order: item.data.order,
  }),
);
---

<WritingLayout
  title={`${entry.data.title} · Blogs · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  articlePublishedTime={entry.data.publishedAt.toISOString()}
  writingItems={blogItems}
  activeId={entry.id}
  backHref="/writing/blogs"
  backLabel="Back to blogs"
  writingType="blogs"
>
  <WritingArticle
    eyebrow="Blog"
    title={entry.data.title}
    summary={entry.data.summary}
    publishedAt={entry.data.publishedAt}
    linkProfile={linkProfile}
  >
    <Content />
  </WritingArticle>
</WritingLayout>
