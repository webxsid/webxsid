---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import IndexGroup from "../../components/content/IndexGroup.astro";
import IndexHeader from "../../components/content/IndexHeader.astro";
import IndexRow from "../../components/content/IndexRow.astro";
import { formatDayMonth } from "../../lib/dates";
import {
  getWritingPath,
  getWritingReadTime,
  groupWritingByYear,
  sortWritingEntries,
  filterPublicWritingEntries,
} from "../../lib/writing";
import { getListOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

const writing = await getCollection("writing");
const entries = sortWritingEntries(filterPublicWritingEntries(writing));
const years = groupWritingByYear(entries);
const maxTags = 3;

const intro =
  "Essays and notes on software, developer tools, and the work of building them.";

const seo = withAutoOgImage(
  {
    title: "Writing · Webxsid",
    description: intro,
    canonical: "/writing",
  },
  getListOgImagePath("writing"),
);
---

<BaseLayout
  title="Writing · Webxsid"
  description={intro}
  seo={seo}
  backHref="/"
>
  <ContentPageFrame>
    <div class="space-y-10">
      <IndexHeader
        title="Writing"
        intro={intro}
        meta={`${entries.length} ${entries.length === 1 ? "post" : "posts"}`}
      />

      <div class="index-groups">
        {
          years.map(({ year, entries }) => (
            <IndexGroup label={String(year)} id={`writing-${year}`}>
              {entries.map((entry) => (
                <IndexRow href={getWritingPath(entry)} title={entry.data.title}>
                  <time
                    slot="aside"
                    datetime={entry.data.publishedAt.toISOString()}
                  >
                    {formatDayMonth(entry.data.publishedAt)}
                  </time>
                  {entry.data.summary}
                  <Fragment slot="meta">
                    {[
                      getWritingReadTime(entry),
                      ...entry.data.tags.slice(0, maxTags),
                    ].join(" · ")}
                  </Fragment>
                </IndexRow>
              ))}
            </IndexGroup>
          ))
        }
      </div>
    </div>
  </ContentPageFrame>
</BaseLayout>
