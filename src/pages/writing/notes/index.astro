---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/shell/Container.astro";
import Section from "../../../components/content/Section.astro";
import ArticleList from "../../../components/content/ArticleList.astro";
import { filterWritingEntries, sortWritingEntries } from "../../../lib/writing";

const writing = await getCollection("writing");
const notes = sortWritingEntries(filterWritingEntries(writing, "note"));
---

<BaseLayout
  title="Notes · Webxsid"
  description="Short notes and lightweight ideas."
  seo={{
    title: "Notes · Webxsid",
    description: "Short notes and lightweight ideas from Webxsid.",
    canonical: "/writing/notes",
  }}
  backHref="/writing"
>
  <Container>
    <div class="py-8 lg:py-14">
      <div class="max-w-4xl space-y-14">
        <Section eyebrow="writing" title="Notes">
          <div
            class="max-w-2xl space-y-5 text-sm leading-7 text-text-muted lg:text-[15px]"
          >
            <p>
              Short operational notes, quick ideas, and lightweight
              observations.
            </p>
          </div>
        </Section>

        <ArticleList
          entries={notes}
          basePath="/writing/notes"
          kindLabel="Note"
        />
      </div>
    </div>
  </Container>
</BaseLayout>
