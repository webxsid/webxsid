---
import { getCollection, render } from "astro:content";
import WritingLayout from "../../../layouts/WritingLayout.astro";
import WritingArticle from "../../../components/WritingArticle.astro";
import { filterWritingEntries, sortWritingEntries } from "../../../lib/writing";

export async function getStaticPaths() {
  const writing = await getCollection("writing");
  const notes = filterWritingEntries(writing, "note");

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const writing = await getCollection("writing");
const noteItems = sortWritingEntries(filterWritingEntries(writing, "note")).map(
  (item) => ({
    id: item.id,
    title: item.data.title,
    publishedAt: item.data.publishedAt,
    order: item.data.order,
  }),
);
---

<WritingLayout
  title={`${entry.data.title} · Notes · Webxsid`}
  description={entry.data.summary}
  seo={entry.data.seo}
  writingItems={noteItems}
  activeId={entry.id}
  backHref="/writing/notes"
  backLabel="Back to notes"
  writingType="notes"
>
  <WritingArticle
    eyebrow="Note"
    title={entry.data.title}
    summary={entry.data.summary}
    publishedAt={entry.data.publishedAt}
  >
    <Content />
  </WritingArticle>
</WritingLayout>
