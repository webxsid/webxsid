---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";
import ContentLinkFooter from "../../components/content/ContentLinkFooter.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import {
  getContentLinkProfiles,
  getEmptyContentLinkProfile,
} from "../../lib/content-links";
import { getStaticOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

export async function getStaticPaths() {
  const work = await getCollection("work");

  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/work/${entry.id}`) ?? getEmptyContentLinkProfile();
const seo = withAutoOgImage(entry.data.seo, getStaticOgImagePath());
---

<BaseLayout
  title={`${entry.data.company} · Work · Webxsid`}
  description={entry.data.summary}
  seo={seo}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articleSection="Work"
  backHref="/"
  backLabel="Back to Home"
>
  <ContentPageFrame>
    <div class="max-w-3xl space-y-10" data-content-preview-scope>
      <ContentHeader
        eyebrow={entry.data.company}
        title={entry.data.title}
        summary={entry.data.summary}
      >
        <span slot="meta"
          >{entry.data.role} · {entry.data.period} - <a
            href={entry.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="meta-link">{entry.data.company}</a
          >
        </span>
      </ContentHeader>

      <ContentDocument class="space-y-4">
        <Content />
      </ContentDocument>

      <ContentLinkFooter profile={linkProfile} />
      <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
    </div>
  </ContentPageFrame>
</BaseLayout>
