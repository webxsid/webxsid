---
import { getCollection, render } from "astro:content";
import WorkLayout from "../../layouts/WorkLayout.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";
import ContentLinkFooter from "../../components/content/ContentLinkFooter.astro";
import { getContentLinkProfiles, getEmptyContentLinkProfile } from "../../lib/content-links";

export async function getStaticPaths() {
  const work = await getCollection("work");

  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const workItems = (await getCollection("work")).map((item) => ({
  id: item.id,
  company: item.data.company,
  period: item.data.period,
  order: item.data.order,
}));
const linkProfiles = await getContentLinkProfiles();
const linkProfile = linkProfiles.get(`/work/${entry.id}`) ?? getEmptyContentLinkProfile();
---

<WorkLayout
  title={`${entry.data.company} · Work · Webxsid`}
  description={entry.data.summary}
  seo={entry.data.seo}
  resourceHints={linkProfile.resourceHints}
  workItems={workItems}
  activeId={entry.id}
>
  <div class="max-w-3xl space-y-10">
    <ContentHeader eyebrow={entry.data.company} title={entry.data.title} summary={entry.data.summary}>
      <span slot="meta">{entry.data.role} · {entry.data.period}</span>
    </ContentHeader>

    <ContentDocument class="space-y-4">
      <Content />
    </ContentDocument>

    <ContentLinkFooter profile={linkProfile} />
  </div>
</WorkLayout>
