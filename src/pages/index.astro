---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/shell/Container.astro";
import HomePreviewItem from "../components/content/HomePreviewItem.astro";
import ContentLinkPreview from "../components/content/ContentLinkPreview.astro";
import Section from "../components/content/Section.astro";
import { getProjectHref } from "../lib/projects";
import {
  getWritingPath,
  sortWritingEntries,
  filterPublicWritingEntries,
} from "../lib/writing";
import { getStaticOgImagePath } from "../lib/og-image";
import { withAutoOgImage } from "../lib/seo";

const [projects, writing] = await Promise.all([
  getCollection("projects"),
  getCollection("writing"),
]);

const featuredProjects = [...projects]
  .sort((a, b) => a.data.order - b.data.order)
  .filter((project) => project.data.featured)
  .slice(0, 2);

const latestWriting = sortWritingEntries(filterPublicWritingEntries(writing))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const seo = withAutoOgImage(
  {
    title: "Webxsid",
    description:
      "Siddharth Mittal's portfolio of projects, writing, references, and work.",
    canonical: "/",
  },
  getStaticOgImagePath(),
);
---

<BaseLayout
  title="Webxsid"
  description="Sid's portfolio: projects, writing, references, and work."
  seo={seo}
>
  <Container class="min-h-[80dvh]">
    <div class="py-4 lg:py-6">
      <Section>
        <div class="space-y-8">
          <div class="space-y-5">
            <div id="intro-head" class="space-y-1">
              <p
                class="ui-title max-w-2xl font-mono font-semibold tracking-tight text-text"
              >
                Siddharth Mittal
              </p>
            </div>
            <div id="intro-copy" class="ui-body space-y-5 text-text">
              <p>
                I'm the guy behind the sceens, keeping systems moving. Most days
                that means tracing failures, simplifying workflows, making
                trade-offs, and trying to leave things a little easier to reason
                about than I found them.
              </p>
              <p>
                Right now building &amp; maintaining the backend systems behind
                remote technical interviews at <a
                  href="/work/taptic"
                  class="inline-link text-text">Taptic</a
                >
                working on everything from scheduling workflows and automation to
                recording infrastructure and the operational tooling around it.
              </p>
              <p>
                Outside of work, I spend my time experementing with ideas,
                building projects, lifting weights and occasionally shouting
                into the void <a
                  href="https://threads.com/@webxsid"
                  target="_blank"
                  class="inline-link text-text">@webxsid</a
                ><a
                  href="/gifs/old-man-yells-at-clouds.gif"
                  class="inline-link text-text"
                  aria-label="Open gif preview"
                >
                  ( evidence )
                </a>.
              </p>
            </div>
          </div>
        </div>

        <hr class="my-8 border-border/70" />
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-8">
          <Section title="Featured Projects">
            <ul class="border-t border-border/70">
              {
                featuredProjects.map((project, idx) => (
                  <li class={idx === 0 ? "" : "border-t border-border/70"}>
                    <HomePreviewItem
                      href={getProjectHref(project) ?? undefined}
                      title={project.data.title}
                      previewType="project"
                      projectStatus={project.data.status}
                      projectStack={project.data.stack}
                      summary={project.data.summary}
                    />
                  </li>
                ))
              }
            </ul>

            <a
              href="/projects"
              class="ui-shell inline-flex items-center font-mono uppercase text-text-muted transition terminal-button"
            >
              View all projects
            </a>
          </Section>

          <Section title="Latest Writing">
            <ul class="border-t border-border/70">
              {
                latestWriting.map((entry, idx) => (
                  <li class={idx === 0 ? "" : "border-t border-border/70"}>
                    <HomePreviewItem
                      href={getWritingPath(entry)}
                      title={entry.data.title}
                      summary={entry.data.summary}
                    />
                  </li>
                ))
              }
            </ul>

            <a
              href="/writing"
              class="ui-shell inline-flex items-center font-mono uppercase text-text-muted transition hover:text-text terminal-button"
            >
              View all writing
            </a>
          </Section>
        </div>
      </Section>
    </div>
    <ContentLinkPreview previewLinks={[]} />
  </Container>
</BaseLayout>
