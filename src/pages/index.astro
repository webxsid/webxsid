---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/shell/Container.astro";
import ContentLinkPreview from "../components/content/ContentLinkPreview.astro";
import IndexGroup from "../components/content/IndexGroup.astro";
import IndexRow from "../components/content/IndexRow.astro";
import StatusBadge from "../components/content/StatusBadge.astro";
import HomeLatestNotes from "../components/content/HomeLatestNotes.astro";
import { portfolio } from "../data/portfolio";
import { formatDate } from "../lib/dates";
import { getProjectHref, getProjectStackLabel } from "../lib/projects";
import {
  getWritingPath,
  getWritingReadTime,
  sortWritingEntries,
  filterPublicWritingEntries,
} from "../lib/writing";
import { getStaticOgImagePath } from "../lib/og-image";
import { withAutoOgImage } from "../lib/seo";
import { formatNowUpdatedAt, getLatestNowEntry } from "../lib/now";
import { sortNotes } from "../lib/notes";

const [projects, writing, nowEntries, notes] = await Promise.all([
  getCollection("projects"),
  getCollection("writing"),
  getCollection("now"),
  getCollection("notes"),
]);

const featuredProjects = [...projects]
  .sort((a, b) => a.data.order - b.data.order)
  .filter((project) => project.data.featured)
  .slice(0, 3);

const latestWriting = sortWritingEntries(filterPublicWritingEntries(writing)).slice(0, 3);
const latestNotes = sortNotes(notes).slice(0, 3);

const latestNow = getLatestNowEntry(nowEntries);

const heroLinks = [
  { label: "portfolio", href: "/portfolio" },
  { label: "résumé", href: portfolio.resume.href },
  { label: "github", href: portfolio.github, external: true },
  { label: "email", href: `mailto:${portfolio.email}` },
];

const seo = withAutoOgImage(
  {
    title: "Webxsid",
    description:
      "Backend engineer building systems that value clarity, ownership, and thoughtful design. Writing about software, developer tools, and the ideas behind them.",
    canonical: "/",
  },
  getStaticOgImagePath(),
);
---

<BaseLayout
  title="Webxsid"
  description="Sid's portfolio: projects, writing, references, and work."
  seo={seo}
>
  <Container>
    <div class="home space-y-14 py-4 lg:space-y-16 lg:py-6">
      <section class="motion-page space-y-6" aria-labelledby="intro-head">
        <div class="space-y-2">
          <h1
            id="intro-head"
            class="ui-title max-w-2xl font-display font-semibold tracking-tight text-text"
          >
            Siddharth Mittal
          </h1>
          <p class="ui-meta font-mono text-text-muted">
            {portfolio.role} ·{" "}
            <a href="/work/taptic" class="index-row-meta-link">Taptic</a>
          </p>
        </div>

        <div id="intro-copy" class="ui-body max-w-[62ch] space-y-5 text-text">
          <p>
            I'm the guy behind the scenes, keeping systems moving. Most days
            that means tracing failures, simplifying workflows, making
            trade-offs, and trying to leave things a little easier to reason
            about than I found them.
          </p>
          <p>
            Right now building &amp; maintaining the backend systems behind
            remote technical interviews at <a
              href="/work/taptic"
              class="inline-link text-text">Taptic</a
            >, working on everything from scheduling workflows and automation
            to recording infrastructure and the operational tooling around it.
          </p>
          <p>
            Outside of work, I spend my time experimenting with ideas,
            building projects, lifting weights and occasionally shouting into
            the void <a
              href="https://threads.com/@webxsid"
              target="_blank"
              class="inline-link text-text">@webxsid</a
            >{" "}<a
              href="/gifs/old-man-yells-at-clouds.gif"
              class="inline-link text-text"
              aria-label="Open gif preview"
            >(evidence)</a>.
          </p>
        </div>

        <nav class="index-row-meta ui-meta font-mono" aria-label="Elsewhere">
          {
            heroLinks.map((link) => (
              <a
                class="index-row-meta-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >{link.external ? `${link.label} ↗` : link.label}</a>
            ))
          }
        </nav>

        {
          latestNow && (
            <a class="home-now" href="/now">
              <span class="home-now-label ui-label font-mono">now</span>
              <span class="home-now-summary ui-prose">
                {latestNow.data.summary}
              </span>
              <span class="home-now-meta ui-meta font-mono">
                updated {formatNowUpdatedAt(latestNow.data.updatedAt)} →
              </span>
            </a>
          )
        }
      </section>

      <IndexGroup
        label="Latest writing"
        id="home-writing"
        href="/writing"
        linkLabel="all writing →"
        pinned={false}
      >
        {
          latestWriting.map((entry) => (
            <IndexRow href={getWritingPath(entry)} title={entry.data.title} clamp>
              {entry.data.summary}
              <Fragment slot="meta">
                <time datetime={entry.data.publishedAt.toISOString()}>
                  {formatDate(entry.data.publishedAt)}
                </time>
                <span>{getWritingReadTime(entry)}</span>
              </Fragment>
            </IndexRow>
          ))
        }
      </IndexGroup>

      <IndexGroup
        label="Featured projects"
        id="home-projects"
        href="/projects"
        linkLabel="all projects →"
        pinned={false}
      >
        {
          featuredProjects.map((project) => (
            <IndexRow
              href={getProjectHref(project)}
              title={project.data.title}
              clamp
            >
              <StatusBadge
                slot="badge"
                status={project.data.status}
                class="shrink-0"
              />
              {project.data.summary}
              <Fragment slot="meta">
                <span>{getProjectStackLabel(project)}</span>
              </Fragment>
            </IndexRow>
          ))
        }
      </IndexGroup>

      <HomeLatestNotes notes={latestNotes} />
    </div>
    <ContentLinkPreview previewLinks={[]} />
  </Container>
</BaseLayout>
