---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import Section from "../../components/content/Section.astro";
import {
  formatReferenceType,
  getReferencePath,
  sortReferenceEntries,
} from "../../lib/references";
import { getListOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

const references = sortReferenceEntries(await getCollection("references"));
const getReferenceMetaDetails = (reference: (typeof references)[number]) =>
  [reference.data.creator, reference.data.year ? String(reference.data.year) : ""]
    .filter(Boolean)
    .join(" · ");

const seo = withAutoOgImage(
  {
    title: "References · Webxsid",
    description: "Books, essays, films, talks, and music I want to remember.",
    canonical: "/references",
  },
  getListOgImagePath("references"),
);
---

<BaseLayout
  title="References · Webxsid"
  description="Books, essays, films, talks, and music I want to remember."
  seo={seo}
  backHref="/"
>
  <ContentPageFrame>
    <div class="space-y-10">
        <Section>
          <div class="space-y-5 text-text-muted">
            <p
              class="ui-title max-w-2xl font-display font-semibold tracking-tight text-text"
            >
              References
            </p>
            <p class="ui-prose">
              Books, essays, films, talks, and music I want to remember.
            </p>
          </div>
        </Section>

        {
          references.length > 0 ? (
            <div class="overflow-x-auto border-y border-border/45">
              <div class="divide-y divide-border/70 md:hidden">
                {
                  references.map((reference) => (
                    <article class="space-y-4 py-5">
                      <div class="space-y-2.5">
                        <a
                          href={getReferencePath(reference)}
                          class="title-link ui-link motion-soft"
                        >
                          {reference.data.title}
                        </a>
                        <p class="ui-meta font-mono text-text-muted">
                          {formatReferenceType(reference.data.type)}
                        </p>
                      </div>

                      <p class="ui-prose text-text-muted">
                        {reference.data.summary}
                      </p>

                      <p class="ui-meta font-mono text-text-muted">
                        {getReferenceMetaDetails(reference)}
                      </p>
                    </article>
                  ))
                }
              </div>

              <div class="hidden md:block">
                <table class="min-w-[44rem] w-full table-fixed border-collapse">
                  <thead class="border-b border-border/45">
                    <tr class="ui-table font-mono text-text-muted">
                      <th class="w-[24%] py-3 pr-6 text-left font-medium">Title</th>
                      <th class="w-[12%] py-3 pr-6 text-left font-medium">Type</th>
                      <th class="w-[42%] py-3 pr-6 text-left font-medium">Summary</th>
                      <th class="w-[22%] py-3 text-left font-medium">Meta</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      references.map((reference) => (
                        <tr class="border-b border-border/45 last:border-b-0">
                          <td class="align-top py-5 pr-6">
                            <a
                              href={getReferencePath(reference)}
                              class="title-link ui-link motion-soft"
                            >
                              {reference.data.title}
                            </a>
                          </td>

                          <td class="align-top py-5 pr-6">
                            <p class="ui-meta font-mono text-text-muted">
                              {formatReferenceType(reference.data.type)}
                            </p>
                          </td>

                          <td class="align-top py-5 pr-6">
                            <p class="ui-prose max-w-3xl text-text-muted">
                              {reference.data.summary}
                            </p>
                          </td>

                          <td class="align-top py-5">
                            <p class="ui-meta font-mono text-text-muted">
                              {getReferenceMetaDetails(reference)}
                            </p>
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <section class="motion-page space-y-3 border-y border-border/45 py-8 sm:py-10">
              <p class="ui-label font-mono text-text-muted">
                References
              </p>
              <h2 class="ui-title max-w-2xl font-display font-semibold tracking-tight text-text">
                No references here yet.
              </h2>
            </section>
          )
        }
    </div>
  </ContentPageFrame>
</BaseLayout>
