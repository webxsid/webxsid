---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import ContentDocument from "../../components/content/ContentDocument.astro";
import ContentHeader from "../../components/content/ContentHeader.astro";
import ContentLinkFooter from "../../components/content/ContentLinkFooter.astro";
import ContentLinkPreview from "../../components/content/ContentLinkPreview.astro";
import { formatReferenceMeta } from "../../lib/references";
import {
  getContentLinkProfiles,
  getEmptyContentLinkProfile,
} from "../../lib/content-links";

export async function getStaticPaths() {
  const references = await getCollection("references");

  return references.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/references/${entry.id}`) ?? getEmptyContentLinkProfile();
---

<BaseLayout
  title={`${entry.data.title} · References · Webxsid`}
  description={entry.data.summary}
  seo={entry.data.seo}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articleSection="References"
  articlePublishedTime={entry.data.publishedAt.toISOString()}
  backHref="/references"
  backLabel="Back to references"
>
  <ContentPageFrame>
    <div class="max-w-4xl space-y-12 lg:space-y-16" data-content-preview-scope>
      <ContentHeader
        eyebrow="Reference"
        title={entry.data.title}
        summary={entry.data.summary}
      >
        <span slot="meta">{formatReferenceMeta(entry)}</span>
      </ContentHeader>

      <ContentDocument class="space-y-4">
        <Content />
      </ContentDocument>

      <ContentLinkFooter profile={linkProfile} />
      <ContentLinkPreview previewLinks={linkProfile.previewLinks} />
    </div>
  </ContentPageFrame>
</BaseLayout>
