---
import NotesLog from "../../components/notes/NotesLog.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getListOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

const seo = withAutoOgImage(
  {
    title: "Notes · Webxsid",
    description: "Short notes and ideas I want to come back to.",
    canonical: "/notes",
  },
  getListOgImagePath("notes"),
);
---

<BaseLayout
  title="Notes · Webxsid"
  description="Short notes and ideas I want to come back to."
  seo={seo}
  backHref="/"
>
  <ContentPageFrame>
    <NotesLog />
  </ContentPageFrame>
</BaseLayout>
