---
import NotesBoard from "../../components/notes/NotesBoard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getListOgImagePath } from "../../lib/og-image";
import { withAutoOgImage } from "../../lib/seo";

const seo = withAutoOgImage(
  {
    title: "Notes · Webxsid",
    description: "Informal notes from Webxsid.",
    canonical: "/notes",
  },
  getListOgImagePath("notes"),
);
---

<BaseLayout
  title="Notes · Webxsid"
  description="Informal notes."
  seo={seo}
  backHref="/"
  hideRail
>
  <NotesBoard />
</BaseLayout>
