---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPageFrame from "../../components/shell/ContentPageFrame.astro";
import NowEntry from "../../components/content/NowEntry.astro";
import {
  getContentLinkProfiles,
  getEmptyContentLinkProfile,
} from "../../lib/content-links";

export async function getStaticPaths() {
  const nowEntries = await getCollection("now");

  return nowEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const linkProfiles = await getContentLinkProfiles();
const linkProfile =
  linkProfiles.get(`/now/${entry.id}`) ?? getEmptyContentLinkProfile();
---

<BaseLayout
  title={`${entry.data.title} · Now · Webxsid`}
  description={entry.data.summary}
  seo={entry.data.seo}
  resourceHints={linkProfile.resourceHints}
  seoType="article"
  articleSection="Now"
  articlePublishedTime={entry.data.updatedAt.toISOString()}
  articleModifiedTime={entry.data.updatedAt.toISOString()}
  backHref="/"
  backLabel="Back home"
>
  <ContentPageFrame>
    <NowEntry entry={entry} linkProfile={linkProfile} showDetailMetadata>
      <Content />
    </NowEntry>
  </ContentPageFrame>
</BaseLayout>
